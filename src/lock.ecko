import std.fs
import std.os

# The kernel's id for this boot. A pid in a lock file from an earlier boot says
# nothing about who holds the lock now, even if that pid is alive again.
fn boot_id() = try { trim(fs.read("/proc/sys/kernel/random/boot_id")) } catch (e) { "" }

# Lock contents: "<pid> <boot id>". A bare "<pid>" (no boot id) is trusted by pid.
fn alive(content) {
    parts = split(trim(content), " ")
    pid = parts[0]
    if len(parts) > 1 and parts[1] != boot_id() { return false }
    re_digits(pid) and fs.exists("/proc/" + pid)
}

fn pid_of(content) = split(trim(content), " ")[0]

fn re_digits(s) = len(s) > 0 and all(chars(s), fn(c) c >= "0" and c <= "9")

# A lock is a symlink whose target is its owner, "<pid> <boot id>": creating
# a symlink fails when the path exists, so taking a free lock is one atomic
# step (Ecko has no exclusive file create). Older locks are plain files with
# the same text, and are still read.
fn present(path) = fs.is_symlink(path) or fs.exists(path)

fn owner_of(path) = try { if fs.is_symlink(path) { fs.readlink(path) } else { fs.read(path) } } catch (e) { "" }

## Create the lock at `path` holding `content`. False when it already exists.
export fn create(path, content) = try { fs.symlink(content, path) true } catch (e) { false }

## Take a pid lock. Returns true when acquired, false when a live process
## holds it. A lock left by a dead process (or an earlier boot) is taken over.
export fn acquire(path) {
    me = string(os.pid())
    if present(path) {
        owner = owner_of(path)
        if pid_of(owner) == me { return true }
        if alive(owner) { return false }
        try { fs.remove(path) } catch (e) { null }
    }
    # If another process took it between the remove and here, it wins.
    create(path, me + " " + boot_id())
}

## Release a lock this process holds. A lock held by someone else is left alone.
export fn release(path) {
    if present(path) and pid_of(owner_of(path)) == string(os.pid()) {
        fs.remove(path)
    }
}

## The pid holding `path`, or null.
export fn holder(path) {
    unless present(path) { return null }
    h = owner_of(path)
    if alive(h) { int(pid_of(h)) } else { null }
}
