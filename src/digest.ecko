import std.fs
import std.io
import std.hash

# A file's content fingerprint, stored as its index sha256 and in the
# object's bbb-sha256 metadata: the SHA-256 of its content.
#
# A large file goes up in parts, and each part is sent with its own hash,
# so the provider refuses a part that changed after it was hashed and what
# is stored always matches its fingerprint. One read gives both the whole
# file's hash and the parts'.
#
# Before 0.7, a large file's fingerprint was built from its part hashes:
# "mp<part size>-<sha256 of the parts' hex hashes joined>". Objects and index
# rows with that form are still understood.

## A stream over bytes [first, first + length) of `path`.
export fn open_range(path, first, length) {
    s = fs.open(path)
    io.seek(s, first)
    io.limit(s, length)
}

## The number of parts a file of `size` bytes splits into at part size `ps`.
export fn part_count(size, ps) = max([1, int((size + ps - 1) / ps)])

## The hex SHA-256 of the whole of `path` and of each of its parts of `ps`
## bytes, from one read: { sha256, parts: [hex] }.
export fn hashes(path, size, ps) {
    mut whole = hash.hasher("sha256")
    mut parts = []
    for i in range(0, part_count(size, ps)) {
        mut part = hash.hasher("sha256")
        for piece in open_range(path, i * ps, min([ps, size - i * ps])) {
            whole = hash.update(whole, piece)
            part = hash.update(part, piece)
        }
        parts = push(parts, hash.finish(part))
    }
    { sha256: hash.finish(whole), parts: parts }
}

## The hex SHA-256 of each part of `path`, in order.
export fn part_hashes(path, size, ps) =
    map(range(0, part_count(size, ps)), fn(i) hash.sha256(open_range(path, i * ps, min([ps, size - i * ps]))))

## The pre-0.7 fingerprint of a file uploaded in parts of `ps` bytes with these hashes.
export fn of_parts(ps, hashes) = "mp{ps}-" + hash.sha256(join(hashes, ""))

## True when the file at `path` matches `fingerprint`, either form.
export fn matches(path, fingerprint) {
    unless starts_with(fingerprint, "mp") { return hash.sha256(fs.open(path)) == fingerprint }
    dash = index_of(fingerprint, "-")
    ps = try { int(fingerprint[2..dash]) } catch (e) { 0 }
    if dash < 0 or ps <= 0 { return false }
    of_parts(ps, part_hashes(path, fs.size(path), ps)) == fingerprint
}
