import std.sql
import std.fs
import std.json
import std.time
import "./util.ecko"

let SCHEMA = [
    "create table if not exists files (job text not null, path text not null, size integer not null, mtime integer not null, sha256 text not null, kind text not null, primary key (job, path))",
    "create table if not exists runs (id text primary key, job text not null, started_at integer not null, finished_at integer, status text not null, uploaded integer not null default 0, replaced integer not null default 0, deleted integer not null default 0, touched integer not null default 0, pruned integer not null default 0, problems integer not null default 0, bytes integer not null default 0, error text, problem_list text)",
    "create index if not exists runs_job_started on runs (job, started_at)",
    "create table if not exists multipart (job text not null, key text not null, upload_id text not null, primary key (job, key, upload_id))",
    "create table if not exists targets (job text primary key, fingerprint text not null)",
    "create table if not exists dirs (job text not null, path text not null, mode text, owner text, mtime integer, primary key (job, path))",
    "create table if not exists verifies (id integer primary key autoincrement, job text not null, started_at integer not null, finished_at integer not null, status text not null, checked integer not null default 0, sampled integer not null default 0, extra integer not null default 0, problems integer not null default 0, problem_list text, error text)",
    "create index if not exists verifies_job_started on verifies (job, started_at)",
]

## Open (creating if needed) the state database in `state_dir`.
export fn open(state_dir) {
    unless fs.exists(state_dir) { fs.mkdir(state_dir) }
    db = sql.open(fs.join(state_dir, "state.db"))
    sql.query(db, "pragma journal_mode = wal")
    for stmt in SCHEMA { sql.exec(db, stmt) }
    migrate(db)
    db
}

# Columns added after the first release. `create table if not exists` leaves
# an existing table alone, so older databases get them here.
let ADDED_COLUMNS = [
    ["runs", "planned", "integer"], ["runs", "done", "integer not null default 0"], ["files", "mode", "text"], ["files", "owner", "text"],
    ["runs", "planned_at", "integer"], ["runs", "progress_at", "integer"],
]

fn migrate(db) {
    for (table, name, decl) in ADDED_COLUMNS {
        have = map(sql.query(db, "pragma table_info({table})"), fn(c) c.name)
        unless contains(have, name) { sql.exec(db, "alter table {table} add column {name} {decl}") }
    }
}

export fn close(db) = sql.close(db)

# ---- file index ----------------------------------------------------------------

## Every indexed file of a job, keyed by path: read rows with
## get(idx, path) -> { path, size, mtime, sha256, kind, mode, owner }. mode
## and owner ("uid:gid") are null for links, and for rows written before
## they were recorded.
export fn index(db, job) = util.index_by(sql.query(db, "select path, size, mtime, sha256, kind, mode, owner from files where job = ? order by path", [job]), fn(r) r.path)

## Insert or replace one index row. row: { path, size, mtime, sha256, kind, mode?, owner? }.
export fn put_file(db, job, row) =
    sql.exec(db, "insert or replace into files (job, path, size, mtime, sha256, kind, mode, owner) values (?, ?, ?, ?, ?, ?, ?, ?)",
        [job, row.path, row.size, row.mtime, row.sha256, row.kind, get(row, "mode"), get(row, "owner")])

## Record files' modes and owners without other changes, in one transaction:
## rows [{ path, mode, owner }]; a null leaves that attribute as it was.
export fn set_attrs(db, job, rows) = sql.transaction(db, fn(tx) {
    for r in rows {
        sql.exec(tx, "update files set mode = coalesce(?, mode), owner = coalesce(?, owner) where job = ? and path = ?", [r.mode, r.owner, job, r.path])
    }
})

export fn remove_file(db, job, path) = sql.exec(db, "delete from files where job = ? and path = ?", [job, path])

## Remove several files from the index in one transaction.
export fn remove_files(db, job, paths) = sql.transaction(db, fn(tx) {
    for p in paths { remove_file(tx, job, p) }
})

## Record a new mtime, mode and owner for a file whose content did not change.
export fn touch_file(db, job, path, mtime, mode = null, owner = null) =
    sql.exec(db, "update files set mtime = ?, mode = coalesce(?, mode), owner = coalesce(?, owner) where job = ? and path = ?", [mtime, mode, owner, job, path])

## Replace a job's whole index (used by --rebuild-state).
export fn replace_index(db, job, rows) = sql.transaction(db, fn(tx) {
    sql.exec(tx, "delete from files where job = ?", [job])
    for r in rows { put_file(tx, job, r) }
})

# ---- folders --------------------------------------------------------------------

## The folder list last uploaded for a job, sorted by path:
## [{ path, mode, owner, mtime }].
export fn dirs(db, job) = sql.query(db, "select path, mode, owner, mtime from dirs where job = ? order by path", [job])

## Replace a job's folder list, once the bucket has the same list.
export fn replace_dirs(db, job, rows) = sql.transaction(db, fn(tx) {
    sql.exec(tx, "delete from dirs where job = ?", [job])
    for r in rows { sql.exec(tx, "insert into dirs (job, path, mode, owner, mtime) values (?, ?, ?, ?, ?)", [job, r.path, r.mode, r.owner, r.mtime]) }
})

# ---- destination fingerprint ----------------------------------------------------

## Where a job's index rows were uploaded to (endpoint|bucket|prefix), or null.
export fn target(db, job) {
    row = sql.query_one(db, "select fingerprint from targets where job = ?", [job])
    if row == null { null } else { row.fingerprint }
}

export fn set_target(db, job, fingerprint) =
    sql.exec(db, "insert or replace into targets (job, fingerprint) values (?, ?)", [job, fingerprint])

# ---- runs ---------------------------------------------------------------------------

export fn start_run(db, job, run_id, started_at) =
    sql.exec(db, "insert into runs (id, job, started_at, status) values (?, ?, ?, 'running')", [run_id, job, started_at])

## How many actions the run will carry out, known once it has planned, and
## when planning finished (`at`, default now): uploads start from there.
export fn set_planned(db, run_id, n, at = null) = sql.exec(db, "update runs set planned = ?, planned_at = ? where id = ?", [n, at ?? time.now(), run_id])

# How many problems a run had: problem_count when the totals carry one (the
# text list is capped), else the list's length.
fn problem_total(t) = get(t, "problem_count") ?? len(t.problems)

## Save a running run's counts so far: `done` actions finished, and the
## running totals { uploaded, replaced, deleted, touched, bytes, problems: [String], problem_count }.
## Saved only when actions have finished, so `at` (default now) is when the
## run last made progress.
export fn save_progress(db, run_id, done, t, at = null) =
    sql.exec(db, "update runs set done = ?, uploaded = ?, replaced = ?, deleted = ?, touched = ?, bytes = ?, problems = ?, problem_list = ?, progress_at = ? where id = ? and status = 'running'",
        [done, t.uploaded, t.replaced, t.deleted, t.touched, t.bytes, problem_total(t), json.encode(t.problems), at ?? time.now(), run_id])

## outcome: { status, finished_at, uploaded, replaced, deleted, touched, pruned, bytes, error, problems: [String] }
export fn finish_run(db, run_id, o) =
    sql.exec(db, "update runs set status = ?, finished_at = ?, uploaded = ?, replaced = ?, deleted = ?, touched = ?, pruned = ?, problems = ?, bytes = ?, error = ?, problem_list = ? where id = ?",
        [o.status, o.finished_at, o.uploaded, o.replaced, o.deleted, o.touched, o.pruned, problem_total(o), o.bytes, o.error, json.encode(o.problems), run_id])

fn decode_run(r) = if r == null { null } else { set(r, "problem_list", if r.problem_list == null { [] } else { json.decode(r.problem_list) }) }

## The most recent run of a job (any status), or null.
export fn last_run(db, job) = decode_run(sql.query_one(db, "select * from runs where job = ? order by started_at desc, id desc limit 1", [job]))

## When the job's newest run that worked (ok or partial) finished, or null.
export fn last_good_at(db, job) {
    row = sql.query_one(db, "select max(finished_at) as at from runs where job = ? and status in ('ok', 'partial')", [job])
    if row == null { null } else { row.at }
}

## The most recent runs of a job, newest first.
export fn recent_runs(db, job, n) = map(sql.query(db, "select * from runs where job = ? order by started_at desc, id desc limit ?", [job, n]), decode_run)

## Mark runs left 'running' by a crash as failed, except those of `busy`
## jobs (a live process still holds their lock). Returns how many.
export fn mark_interrupted(db, now, busy = []) {
    mut n = 0
    for r in sql.query(db, "select id, job from runs where status = 'running'") {
        if contains(busy, r.job) { continue }
        n = n + sql.exec(db, "update runs set status = 'failed', finished_at = ?, error = 'interrupted: the process stopped before the run finished' where id = ?", [now, r.id])
    }
    n
}

# ---- verification ---------------------------------------------------------------

## Record one verification. v: { started_at, finished_at, status: "ok" |
## "failed" (found problems) | "error" (could not finish), checked, sampled,
## extra, problems: [String], problem_count, error }.
export fn add_verify(db, job, v) =
    sql.exec(db, "insert into verifies (job, started_at, finished_at, status, checked, sampled, extra, problems, problem_list, error) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
        [job, v.started_at, v.finished_at, v.status, v.checked, v.sampled, v.extra, problem_total(v), json.encode(v.problems), v.error])

## The most recent verification of a job (any status), or null.
export fn last_verify(db, job) = decode_run(sql.query_one(db, "select * from verifies where job = ? order by started_at desc, id desc limit 1", [job]))

## When the job's newest verification that finished (ok or failed) started, or null.
export fn last_verified_at(db, job) {
    row = sql.query_one(db, "select max(started_at) as at from verifies where job = ? and status in ('ok', 'failed')", [job])
    if row == null { null } else { row.at }
}

# ---- multipart bookkeeping -------------------------------------------------------------

export fn add_multipart(db, job, key, upload_id) =
    sql.exec(db, "insert or ignore into multipart (job, key, upload_id) values (?, ?, ?)", [job, key, upload_id])

export fn remove_multipart(db, job, key, upload_id) =
    sql.exec(db, "delete from multipart where job = ? and key = ? and upload_id = ?", [job, key, upload_id])

export fn list_multipart(db, job) = sql.query(db, "select key, upload_id from multipart where job = ?", [job])
