import std.hash
import std.encoding
import std.re

## SHA-256 of the empty string: the payload hash of a request with no body.
export let EMPTY_SHA256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

## RFC 3986 encoding as SigV4 requires it: everything except A-Z a-z 0-9 - _ . ~
## is percent-encoded as UTF-8 with uppercase hex. "/" is kept when
## encode_slash is false (object key paths) and encoded otherwise (query values).
export fn uri_encode(s, encode_slash) {
    mut out = []
    for c in chars(s) {
        if re.test(r"^[A-Za-z0-9\-_.~]$", c) or (c == "/" and not encode_slash) {
            out = push(out, c)
        } else {
            hex = upper(encoding.hex_encode(c))
            for pair in chunk(chars(hex), 2) { out = push(out, "%" + join(pair, "")) }
        }
    }
    join(out, "")
}

fn canonical_query(query) {
    pairs = map(keys(query), fn(k) [uri_encode(k, true), uri_encode(string(query[k]), true)])
    sorted = sort_with(pairs, fn(a, b) if a[0] < b[0] { -1 } else if a[0] > b[0] { 1 } else if a[1] < b[1] { -1 } else if a[1] > b[1] { 1 } else { 0 })
    join(map(sorted, fn(p) p[0] + "=" + p[1]), "&")
}

fn clean_value(v) = re.replace(r"\s+", trim(string(v)), " ")

## The signed header names, lowercase, sorted, joined with ";".
export fn signed_headers(headers) = join(sort(map(keys(headers), fn(k) lower(k))), ";")

## The SigV4 canonical request. `req` is
## { method, path, query: {String: String}, headers: {String: String}, payload_hash }
## where `path` is the raw (unencoded) path starting with "/".
export fn canonical_request(req) {
    lowered = reduce(keys(req.headers), fn(acc, k) set(acc, lower(k), clean_value(req.headers[k])), {})
    names = sort(keys(lowered))
    header_block = join(map(names, fn(n) n + ":" + lowered[n] + "\n"), "")
    join([
        upper(req.method),
        uri_encode(req.path, false),
        canonical_query(req.query),
        header_block,
        join(names, ";"),
        req.payload_hash,
    ], "\n")
}

## "<date>/<region>/<service>/aws4_request"
export fn scope(amz_date, region, service) = amz_date[..8] + "/" + region + "/" + service + "/aws4_request"

export fn string_to_sign(amz_date, scope_str, canonical) =
    join(["AWS4-HMAC-SHA256", amz_date, scope_str, hash.sha256(canonical)], "\n")

## The derived signing key (bytes). `secret_key` is a secret.
export fn signing_key(secret_key, date, region, service) {
    k_date = hash.hmac_sha256_bytes("AWS4" + reveal(secret_key), date)
    k_region = hash.hmac_sha256_bytes(k_date, region)
    k_service = hash.hmac_sha256_bytes(k_region, service)
    hash.hmac_sha256_bytes(k_service, "aws4_request")
}

## Sign a request. Adds x-amz-date to the headers, then returns the full header
## map to send, including authorization. `creds` is { access_key, secret_key }.
## `amz_date` is "YYYYMMDDTHHMMSSZ" (UTC).
export fn sign(req, creds, region, service, amz_date) {
    headers = set(req.headers, "x-amz-date", amz_date)
    signed_req = set(req, "headers", headers)
    canonical = canonical_request(signed_req)
    sc = scope(amz_date, region, service)
    sts = string_to_sign(amz_date, sc, canonical)
    key = signing_key(creds.secret_key, amz_date[..8], region, service)
    signature = encoding.hex_encode(hash.hmac_sha256_bytes(key, sts))
    auth = "AWS4-HMAC-SHA256 Credential=" + creds.access_key + "/" + sc +
        ", SignedHeaders=" + signed_headers(headers) + ", Signature=" + signature
    set(headers, "authorization", auth)
}
