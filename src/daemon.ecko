import std.fs
import std.time
import std.signal
import std.bg
import std.http
import "./config.ecko"
import "./state.ecko"
import "./scheduler.ecko"
import "./runner.ecko"
import "./logging.ecko"
import "./lock.ecko"
import "./dashboard.ecko"

let DRAIN_MS = 60000

fn errors_text(e) = join(get(e, "errors") ?? [string(get(e, "message") ?? e)], "; ")

## Run the scheduler until SIGTERM/SIGINT. SIGHUP reloads the config.
## Returns the process exit code.
export fn run(config_path) {
    cfg = try { config.load(config_path) } catch (e) {
        logging.emit("error", "invalid config: " + errors_text(e), {})
        return 64
    }
    logging.setup(cfg.log)
    for w in cfg.warnings { logging.emit("warn", w, {}) }
    unless fs.exists(cfg.state_dir) { fs.mkdir(cfg.state_dir) }
    lock_path = fs.join(cfg.state_dir, "daemon.lock")
    unless lock.acquire(lock_path) {
        logging.emit("error", "another bit-by-bit daemon is running", { pid: lock.holder(lock_path) })
        return 1
    }
    # Whatever happens from here, the next daemon must be able to start.
    # (`catch` rethrows: without one, Ecko 0.68's `finally` swallows the error.)
    try { serve(cfg, config_path) } catch (e) { error(e) } finally { lock.release(lock_path) }
}

# The daemon proper, once it holds the daemon lock. Returns the exit code.
fn serve(first_cfg, config_path) {
    mut cfg = first_cfg
    db = state.open(cfg.state_dir)
    # A manual `bit-by-bit run` may still be going: its job lock says so.
    busy = map(filter(cfg.jobs, fn(j) lock.holder(runner.job_lock_path(cfg, j)) != null), fn(j) j.name)
    stale = state.mark_interrupted(db, time.now(), busy)
    if stale > 0 { logging.emit("warn", "marked runs interrupted by the last shutdown as failed", { count: stale }) }
    started = time.now()
    # The dashboard reads the live config through this cell, so a reload shows up there too.
    cfg_cell = cell(cfg)
    mut dashboard_up = false
    if cfg.dashboard != null {
        try {
            dport = dashboard.start(cfg_cell, cfg.state_dir, started)
            dashboard_up = true
            logging.emit("info", "dashboard listening", { host: cfg.dashboard.host, port: dport })
        } catch (e) {
            # Backups matter more than the dashboard: log it and carry on.
            logging.emit("error", string(get(e, "message") ?? e), {})
        }
    }
    sigs = signal.on(["term", "int", "hup"])
    stopping = cell(false)
    should_stop = fn() cell_get(stopping)
    mut tasks = {}
    logging.emit("info", "daemon started", { jobs: len(cfg.jobs), config: config_path })

    while true {
        now = time.now()
        for name in keys(tasks) {
            if bg.status(tasks[name]) != "running" { tasks = remove(tasks, name) }
        }
        mut due_times = []
        for job in cfg.jobs {
            if has(tasks, job.name) { continue }
            runs = try { state.recent_runs(db, job.name, 10) } catch (e) {
                logging.emit("error", "can't read run history: " + string(get(e, "message") ?? e), { job: job.name })
                []
            }
            due = scheduler.next_run(job.schedule, runs, now, scheduler.local_offset_ms)
            if due <= now {
                run_cfg = cfg
                # Each run gets its own connection. Jobs run at the same time,
                # and on a shared one a job's plain writes would land inside
                # another job's open transaction, and be lost if it rolled back.
                tasks = set(tasks, job.name, bg.spawn(fn() {
                    job_db = try { state.open(run_cfg.state_dir) } catch (e) {
                        logging.emit("error", "can't open the state database: " + string(get(e, "message") ?? e), { job: job.name })
                        return null
                    }
                    try { runner.run_job(run_cfg, job, job_db, { dry_run: false, should_stop: should_stop }) } catch (e) { error(e) } finally { state.close(job_db) }
                }))
            } else {
                due_times = push(due_times, due)
            }
        }
        sig = signal.next(sigs, scheduler.wait_ms(due_times, now))
        if sig == "hup" {
            try {
                cfg = config.load(config_path)
                cell_set(cfg_cell, cfg)
                logging.setup(cfg.log)
                logging.emit("info", "config reloaded", { jobs: len(cfg.jobs) })
            } catch (e) {
                logging.emit("error", "config reload rejected, keeping the old config: " + errors_text(e), {})
            }
        } else if sig == "term" or sig == "int" {
            logging.emit("info", "shutdown requested, letting running jobs reach a safe point", { running: len(tasks) })
            cell_set(stopping, true)
            break
        }
    }

    deadline = time.now() + DRAIN_MS
    while time.now() < deadline and any(values(tasks), fn(t) bg.status(t) == "running") { sleep(200) }
    for t in values(tasks) {
        if bg.status(t) == "running" { bg.cancel(t) }
    }
    if dashboard_up { http.stop() }
    signal.close(sigs)
    state.close(db)
    logging.emit("info", "daemon stopped", {})
    0
}
