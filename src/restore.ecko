import std.fs
import std.io
import std.hash
import std.encoding
import "./s3.ecko"
import "./sync.ecko"
import "./scanner.ecko"
import "./util.ecko"

fn wanted(path, sub) = sub == null or path == sub or starts_with(path, sub + "/")

# Split a job's remote listing into current objects and version copies:
# { current: {path: { path, key }}, versions: {path: [{ path, ts, key }]} }
fn catalogue(c, job) {
    vprefix = job.prefix + "/_versions/"
    mut current = []
    mut versions = []
    # Another job may share the prefix: keep to this job's own paths.
    mine = fn(path) scanner.under_any(path, job.paths)
    for o in s3.list_objects(c, job.prefix + "/") {
        if starts_with(o.key, vprefix) {
            rest = o.key[len(vprefix)..]
            slash = index_of(rest, "/")
            if slash < 0 or not mine(rest[slash..]) { continue }
            versions = push(versions, { path: rest[slash..], ts: rest[..slash], key: o.key })
        } else {
            path = o.key[len(job.prefix)..]
            if mine(path) { current = push(current, { path: path, key: o.key }) }
        }
    }
    { current: util.index_by(current, fn(x) x.path), versions: group_by(versions, fn(x) x.path) }
}

fn run_ms_of(c, key) {
    meta = s3.head_object(c, key)
    if meta == null or not has(meta, "run") { return null }
    try { sync.run_ts_ms(meta.run) } catch (e) { null }
}

## What a restore would bring back: [{ path, key }] sorted by path.
## opts: { path: String or null, at_ms: Int or null }
export fn select(c, job, opts) {
    cat = catalogue(c, job)
    sub = get(opts, "path")
    at = get(opts, "at_ms")
    if at == null {
        return map(filter(sort(keys(cat.current)), fn(p) wanted(p, sub)), fn(p) get(cat.current, p))
    }
    paths = unique(keys(cat.current) + keys(cat.versions)) |> filter(fn(p) wanted(p, sub)) |> sort
    mut out = []
    for p in paths {
        cur = get(cat.current, p)
        if cur != null {
            ms = run_ms_of(c, cur.key)
            if ms != null and ms <= at {
                out = push(out, { path: p, key: cur.key })
                continue
            }
        }
        # The earliest copy moved aside after `at` holds the content as of `at`,
        # provided that content had already been uploaded by then.
        later = sort_by(filter(get(cat.versions, p) ?? [], fn(v) sync.run_ts_ms(v.ts) > at), fn(v) v.ts)
        if len(later) > 0 {
            ms = run_ms_of(c, later[0].key)
            if ms != null and ms <= at { out = push(out, { path: p, key: later[0].key }) }
        }
    }
    out
}

# A key could hold ".." segments (a tampered or foreign bucket); restoring it
# would write outside --to.
fn unsafe(path) = not starts_with(path, "/") or contains(split(path, "/"), "..")

fn restore_one(c, item, to, overwrite) {
    if unsafe(item.path) {
        return { status: "failed", message: "{item.path}: unsafe path, refusing to restore it" }
    }
    target = to + item.path
    if (fs.exists(target) or fs.is_symlink(target)) and not overwrite {
        return { status: "skipped", message: "{target}: exists (use --overwrite)" }
    }
    dir = fs.dirname(target)
    unless fs.exists(dir) { fs.mkdir(dir) }
    got = s3.get_stream(c, item.key)
    meta = got.meta
    if has(meta, "symlink") {
        io.close(got.body)
        if fs.exists(target) or fs.is_symlink(target) { fs.remove(target) }
        fs.symlink(encoding.url_decode(meta.symlink), target)
        return { status: "restored" }
    }
    partial = target + ".bbb-partial"
    out = fs.open(partial, "w")
    for piece in got.body { io.write(out, piece) }
    io.close(out)
    if has(meta, "sha256") and hash.sha256(fs.open(partial)) != meta.sha256 {
        fs.remove(partial)
        return { status: "failed", message: "{target}: checksum mismatch, download discarded" }
    }
    fs.rename(partial, target)
    if has(meta, "mode") { fs.chmod(target, meta.mode) }
    if has(meta, "mtime") { fs.set_modified(target, int(meta.mtime)) }
    { status: "restored" }
}

## Restore files. opts: { path, at_ms, to, overwrite, oldest_ms }
## `oldest_ms` is how far back version history reaches (now - keep_versions_days).
## Returns { restored: Int, skipped: [String], failed: [String] }.
export fn restore(c, job, opts) {
    at = get(opts, "at_ms")
    if at != null and at < opts.oldest_ms {
        error({ kind: "usage", message: "--at is older than this job's version history (keep_versions_days = {job.keep_versions_days})" })
    }
    items = select(c, job, opts)
    mut restored = 0
    mut skipped = []
    mut failed = []
    for item in items {
        r = try { restore_one(c, item, opts.to, opts.overwrite) } catch (e) {
            { status: "failed", message: item.path + ": " + string(get(e, "message") ?? e) }
        }
        match r.status {
            "restored" => { restored = restored + 1 }
            "skipped" => { skipped = push(skipped, r.message) }
            _ => { failed = push(failed, r.message) }
        }
    }
    { restored: restored, skipped: skipped, failed: failed }
}
