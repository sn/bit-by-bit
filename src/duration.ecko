import std.re

## Parse a duration such as "500ms", "30s", "5m", "6h" or "1d" into milliseconds.
## Raises { kind: "config" } on anything else, including zero and negatives.
export fn parse_duration(s) {
    caps = if is_string(s) { re.captures(r"^(\d+)(ms|s|m|h|d)$", s) } else { null }
    if caps == null {
        error({ kind: "config", message: "invalid duration '{s}' - use a number followed by ms, s, m, h or d" })
    }
    n = int(caps[1])
    if n == 0 { error({ kind: "config", message: "duration '{s}' must be greater than zero" }) }
    unit = match caps[2] {
        "ms" => 1
        "s" => 1000
        "m" => 60000
        "h" => 3600000
        _ => 86400000
    }
    n * unit
}

## Parse a byte size such as "64MiB", "512KiB", "1GiB" or a plain Int into bytes.
export fn parse_size(s) {
    if type_of(s) == "int" and s > 0 { return s }
    caps = if is_string(s) { re.captures(r"^(\d+)(B|KiB|MiB|GiB)$", s) } else { null }
    if caps == null {
        error({ kind: "config", message: "invalid size '{s}' - use a number followed by B, KiB, MiB or GiB" })
    }
    n = int(caps[1])
    if n == 0 { error({ kind: "config", message: "size '{s}' must be greater than zero" }) }
    mult = match caps[2] {
        "B" => 1
        "KiB" => 1024
        "MiB" => 1048576
        _ => 1073741824
    }
    n * mult
}

## Parse "HH:MM" (24-hour) into { hour, minute }.
export fn parse_hhmm(s) {
    caps = if is_string(s) { re.captures(r"^([01]\d|2[0-3]):([0-5]\d)$", s) } else { null }
    if caps == null {
        error({ kind: "config", message: "invalid time '{s}' - use 24-hour HH:MM, e.g. 02:30" })
    }
    { hour: int(caps[1]), minute: int(caps[2]) }
}
