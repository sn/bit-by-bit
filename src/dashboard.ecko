import std.http
import std.sql
import std.fs
import std.bg
import std.time
import "./state.ecko"
import "./scheduler.ecko"
import "./status.ecko"

let RECENT_RUNS = 10
let REFRESH_SECONDS = 30
let REFRESH_RUNNING_SECONDS = 3
let DAY = 86400000

## A connection to the state database that refuses writes (SQLite
## `query_only`): the dashboard only ever reads.
export fn open_readonly(state_dir) {
    db = sql.open(fs.join(state_dir, "state.db"))
    sql.query(db, "pragma query_only = 1")
    db
}

fn interval_ms(schedule) = if schedule.kind == "every" { schedule.ms } else { DAY }

fn duration(r) = if r.finished_at == null { null } else { r.finished_at - r.started_at }

fn run_view(r) = {
    id: r.id, status: r.status, started_at: r.started_at, finished_at: r.finished_at,
    duration_ms: duration(r), uploaded: r.uploaded, replaced: r.replaced, deleted: r.deleted,
    pruned: r.pruned, bytes: r.bytes, problem_count: r.problems, error: r.error,
    planned: get(r, "planned"), done: get(r, "done") ?? 0,
    planned_at: get(r, "planned_at"), progress_at: get(r, "progress_at"),
}

# When a running run last showed signs of life: a file finished, planning
# finished, or it started.
fn last_activity(r) = get(r, "progress_at") ?? get(r, "planned_at") ?? r.started_at

fn job_view(job, db, now) {
    runs = state.recent_runs(db, job.name, RECENT_RUNS)
    last = first(runs)
    last_ms = if last == null { null } else { last.started_at }
    # Overdue: no run has started for twice the interval. Stalled: the run
    # going now has finished no file for that long. A long run that keeps
    # finishing files, like a first backup of a big disk, is neither.
    limit = 2 * interval_ms(job.schedule)
    running = last != null and last.status == "running"
    overdue = last != null and not running and now - last.started_at > limit
    stalled = running and now - last_activity(last) > limit
    {
        job: job.name,
        schedule: job.schedule,
        destination: job.destination,
        prefix: job.prefix,
        paths: job.paths,
        last_good_at: state.last_good_at(db, job.name),
        status: if last == null { "never run" } else { last.status },
        started_at: last_ms,
        finished_at: if last == null { null } else { last.finished_at },
        next_due: scheduler.next_run(job.schedule, runs, now, scheduler.local_offset_ms),
        overdue: overdue,
        stalled: stalled,
        planned_at: if last == null { null } else { get(last, "planned_at") },
        uploaded: if last == null { 0 } else { last.uploaded },
        replaced: if last == null { 0 } else { last.replaced },
        deleted: if last == null { 0 } else { last.deleted },
        pruned: if last == null { 0 } else { last.pruned },
        bytes: if last == null { 0 } else { last.bytes },
        planned: if last == null { null } else { get(last, "planned") },
        done: if last == null { 0 } else { get(last, "done") ?? 0 },
        error: if last == null { null } else { last.error },
        problems: if last == null { [] } else { last.problem_list },
        problem_count: if last == null { 0 } else { last.problems },
        check: status.check_view(state.last_verify(db, job.name)),
        check_on: job.verify != null,
        runs: map(runs, run_view),
    }
}

## Why the backups are unhealthy: { ok: Bool, reasons: [String] }. A job is
## unhealthy when its last run failed, when it has not started a run for
## more than twice its interval, when its running backup has finished no
## file for that long, or when the last check of its backup found problems.
export fn health(snap) {
    mut reasons = []
    for j in snap.jobs {
        if j.status == "failed" { reasons = push(reasons, "{j.job}: last run failed") }
        if j.overdue { reasons = push(reasons, "{j.job}: overdue (no run for more than twice its interval)") }
        if j.stalled { reasons = push(reasons, "{j.job}: stalled (the running backup has finished no file for more than twice its interval)") }
        if j.check != null and j.check.status == "failed" {
            n = j.check.problem_count
            reasons = push(reasons, "{j.job}: the last check found {n} " + (if n == 1 { "problem" } else { "problems" }) + " in the backup")
        }
    }
    { ok: len(reasons) == 0, reasons: reasons }
}

## Everything the dashboard shows, as plain data.
export fn snapshot(cfg, db, now, started_at) {
    jobs = map(cfg.jobs, fn(job) job_view(job, db, now))
    base = { daemon: { started_at: started_at, uptime_ms: now - started_at, now: now }, jobs: jobs }
    h = health(base)
    merge(base, { healthy: h.ok, reasons: h.reasons })
}

# ---- HTML ------------------------------------------------------------------------

fn esc(v) = escape_html(string(v ?? ""))

fn at_text(ms) = if ms == null { "never" } else { time.format_local(ms, "%Y-%m-%d %H:%M") }

fn dur_text(ms) {
    if ms == null { return "in progress" }
    secs = int(ms / 1000)
    if secs < 60 { "{secs}s" } else if secs < 3600 { string(int(secs / 60)) + "m " + string(secs % 60) + "s" } else { string(int(secs / 3600)) + "h " + string(int(secs % 3600 / 60)) + "m" }
}

# "3h ago", "in 21h": the age of a time at a glance. The exact time sits next to it.
fn span_text(ms) {
    mins = (ms + 30000) // 60000
    if mins < 1 { "under a minute" } else if mins < 60 { "{mins}m" } else if mins < 2880 { string((mins + 30) // 60) + "h" } else { string((mins + 720) // 1440) + "d" }
}

fn ago_text(ms, now) = if ms == null { "never" } else if now - ms < 60000 { "just now" } else { span_text(now - ms) + " ago" }

fn until_text(ms, now) = if ms <= now { "due now" } else { "in " + span_text(ms - now) }

fn schedule_text(s) {
    if s.kind == "every" {
        mins = s.ms // 60000
        if mins >= 2880 and mins % 1440 == 0 { "every " + string(mins // 1440) + "d" } else if mins % 60 == 0 { "every " + string(mins // 60) + "h" } else { "every {mins}m" }
    } else {
        "daily at " + pad2(s.hour) + ":" + pad2(s.minute)
    }
}

# 300897 -> "300,897"
fn commas(n) {
    digits = string(n)
    if len(digits) <= 3 { return digits }
    commas(digits[..len(digits) - 3]) + "," + digits[len(digits) - 3..]
}

fn pad2(n) = if n < 10 { "0" + string(n) } else { string(n) }

let GLYPHS = { ok: "✓", partial: "!", running: "…", failed: "×", "never run": "–" }

fn tone(s) = match s { "ok" => "ok" "partial" => "warn" "running" => "info" "never run" => "muted" _ => "bad" }

# A status is always its word; the colour and glyph only repeat it.
fn badge(s) = "<span class=\"badge " + tone(s) + "\"><span aria-hidden=\"true\">" + (get(GLYPHS, s) ?? "×") + "</span> " + esc(s) + "</span>"

fn li(p) = "<li>" + esc(p) + "</li>"

let SHOWN_PROBLEMS = 5

# The first few problems, and the rest behind a disclosure: never cut off.
fn problems_html(j) {
    n = max([j.problem_count, len(j.problems)])
    if n == 0 { return "" }
    # A run keeps the text of its first 1,000 problems and counts the rest.
    unlisted = n - len(j.problems)
    note = if unlisted <= 0 { "" } else { "<p class=\"progress-text\">" + commas(unlisted) + " more problems not listed: a run keeps the first " + commas(len(j.problems)) + ". See the log for all of them.</p>" }
    rest = len(j.problems) - SHOWN_PROBLEMS
    more = if rest <= 0 { "" } else {
        word = if rest == 1 { "problem" } else { "problems" }
        "<details id=\"problems-" + j.job + "\"><summary id=\"problems-" + j.job + "-more\">Show " + string(rest) + " more " + word + "</summary><ul class=\"problems\">" +
            join(map(drop(j.problems, SHOWN_PROBLEMS), li), "") + "</ul></details>"
    }
    "<section class=\"block\"><h3>problems <span class=\"count warn\">" + commas(n) + "</span></h3><ul class=\"problems\">" +
        join(map(take(j.problems, SHOWN_PROBLEMS), li), "") + "</ul>" + more + note + "</section>"
}

fn run_row(r) = "<tr><td>" + esc(at_text(r.started_at)) + "</td><td>" + badge(r.status) + "</td><td>" + esc(dur_text(r.duration_ms)) +
    "</td><td class=\"num\">" + commas(r.uploaded) + "</td><td class=\"num\">" + commas(r.replaced) + "</td><td class=\"num\">" + commas(r.deleted) +
    "</td><td class=\"num\">" + esc(status.size_text(r.bytes)) + "</td><td class=\"num\">" + commas(r.problem_count) + "</td></tr>"

# The recent runs as a strip, oldest first: a glance at the pattern. The table
# below carries the same facts as text, so the strip is hidden from assistive tech.
fn history(j) {
    if len(j.runs) == 0 { return "" }
    ticks = join(map(reverse(j.runs), fn(r) "<li class=\"tick " + tone(r.status) + "\" title=\"" + esc(at_text(r.started_at) + " · " + r.status) + "\">" +
        (get(GLYPHS, r.status) ?? "×") + "</li>"), "")
    "<ol class=\"history\" aria-hidden=\"true\">" + ticks + "</ol>"
}

fn kpi(label, value, detail) = kpi_as("kpi", label, value, detail)
fn kpi_as(cls, label, value, detail) = "<div class=\"" + cls + "\"><dt>" + label + "</dt><dd><span class=\"value\">" + esc(value) + "</span><span class=\"when\">" + esc(detail) + "</span></dd></div>"

fn stat(label, value) = "<div><dt>" + label + "</dt><dd>" + esc(if type_of(value) == "int" { commas(value) } else { value }) + "</dd></div>"

# Rounded down, so a run shows 100% only once every file is done.
fn percent(done, planned) = if planned <= 0 { 100 } else { min([100, done * 100 // planned]) }

# A run in progress: how far it has got, how fast, and roughly how long is
# left, from the progress it saves to the database about once a second.
fn progress_html(j, now) {
    bar_label = "backup progress of " + esc(j.job)
    if j.planned == null {
        return "<section class=\"block\"><h3>in progress</h3><progress id=\"progress-" + j.job + "\" aria-label=\"" + bar_label + "\"></progress>" +
            "<p class=\"progress-text\">scanning files…</p></section>"
    }
    # From the end of planning: the scan before it moves no files.
    elapsed_s = max([1, (now - (j.planned_at ?? j.started_at)) // 1000])
    rate = j.done / elapsed_s
    pace = if j.done == 0 { "starting uploads" } else {
        left = if rate > 0 { (j.planned - j.done) / rate * 1000 } else { 0 }
        per = if rate >= 10 { string(int(rate)) } else { string(int(rate * 10) / 10) }
        per + " files/s · about " + span_text(left) + " left"
    }
    "<section class=\"block\"><h3>in progress</h3>" +
        "<progress id=\"progress-" + j.job + "\" max=\"" + string(j.planned) + "\" value=\"" + string(j.done) + "\" aria-label=\"" + bar_label + "\"></progress>" +
        "<p class=\"progress-text\"><strong>" + string(percent(j.done, j.planned)) + "% · " + commas(j.done) + " of " + commas(j.planned) + "</strong> files · " + replace(esc(status.size_text(j.bytes)), " ", "&nbsp;") + " · " + esc(pace) + "</p>" +
        "<dl class=\"stats\">" + stat("uploaded", j.uploaded) + stat("replaced", j.replaced) + stat("deleted", j.deleted) + "</dl></section>"
}

fn meta_item(label, value) = "<div><dt>" + label + "</dt><dd>" + esc(value) + "</dd></div>"

# The last check of the backup, in a few words; the time is in its title.
fn check_meta(j, now) {
    c = j.check
    if c == null { return meta_item("checked", if j.check_on { "not yet" } else { "off" }) }
    what = match c.status {
        "ok" => "all " + commas(c.checked) + " files there"
        "failed" => commas(c.problem_count) + (if c.problem_count == 1 { " problem" } else { " problems" })
        _ => "couldn't finish"
    }
    "<div title=\"" + esc(at_text(c.at)) + "\"><dt>checked</dt><dd>" + esc(ago_text(c.at, now) + " · " + what) + "</dd></div>"
}

# What the last check found, when it found something: the first few problems
# and what happens next. The rest are in the log and `bit-by-bit verify`.
fn check_callout(j) {
    c = j.check
    if c == null or c.status != "failed" { return "" }
    n = max([c.problem_count, len(c.problems)])
    "<div class=\"callout\"><strong>the last check found " + commas(n) + (if n == 1 { " problem" } else { " problems" }) + "</strong>" +
        "<ul class=\"problems\">" + join(map(take(c.problems, SHOWN_PROBLEMS), li), "") + "</ul>" +
        "<p>Files still on this machine go up again with the next run. After it, <code>sudo bit-by-bit verify " + esc(j.job) + "</code> checks again.</p></div>"
}

fn job_card(j, now) {
    overdue = if j.overdue { " <span class=\"badge bad\"><span aria-hidden=\"true\">!</span> overdue</span>" } else if j.stalled { " <span class=\"badge bad\"><span aria-hidden=\"true\">!</span> stalled</span>" } else { "" }
    meta = "<dl class=\"job-meta\">" + meta_item("from", join(j.paths, ", ")) + meta_item("to", j.destination + "/" + j.prefix) +
        meta_item("runs", schedule_text(j.schedule)) + check_meta(j, now) + "</dl>"
    took = if j.started_at == null { "" } else if j.finished_at == null { "running for " + span_text(now - j.started_at) } else { "took " + dur_text(j.finished_at - j.started_at) }
    kpis = "<dl class=\"kpis\">" +
        kpi_as("kpi lead", "last good backup", ago_text(j.last_good_at, now), if j.last_good_at == null { "no run has worked yet" } else { at_text(j.last_good_at) }) +
        kpi("last run", ago_text(j.started_at, now), if j.started_at == null { "" } else { at_text(j.started_at) + " · " + took }) +
        kpi("next run", until_text(j.next_due, now), if j.next_due <= now { "" } else { at_text(j.next_due) }) +
        "</dl>"
    stats = if j.finished_at == null { "" } else {
        "<section class=\"block\"><h3>changes in the last run</h3><dl class=\"stats\">" + stat("uploaded", j.uploaded) + stat("replaced", j.replaced) +
            stat("deleted", j.deleted) + stat("pruned", j.pruned) + stat("data", status.size_text(j.bytes)) + "</dl></section>"
    }
    live = if j.started_at != null and j.finished_at == null { progress_html(j, now) } else { "" }
    err = (if j.error == null { "" } else { "<div class=\"callout\"><strong>last run failed</strong><p>" + esc(j.error) + "</p></div>" }) + check_callout(j)
    runs = if len(j.runs) == 0 {
        due = if j.next_due <= now { "as soon as the daemon is free" } else { at_text(j.next_due) }
        "<div class=\"empty\"><p><strong>No runs yet.</strong> The first run starts " + esc(due) + ". To start it now: <code>sudo bit-by-bit run " + esc(j.job) + "</code></p></div>"
    } else {
        "<section class=\"block\"><div class=\"block-head\"><h3>recent runs</h3>" + history(j) + "</div>" +
            "<div class=\"table-wrap\" id=\"runs-" + j.job + "\" role=\"region\" aria-label=\"recent runs of " + esc(j.job) + "\" tabindex=\"0\"><table>" +
            "<thead><tr><th>started</th><th>status</th><th>took</th><th class=\"num\">uploaded</th><th class=\"num\">replaced</th>" +
            "<th class=\"num\">deleted</th><th class=\"num\">data</th><th class=\"num\">problems</th></tr></thead><tbody>" +
            join(map(j.runs, run_row), "") + "</tbody></table></div></section>"
    }
    "<section class=\"job " + tone(j.status) + "\" aria-labelledby=\"job-" + j.job + "\">" +
        "<header class=\"job-head\"><h2 id=\"job-" + j.job + "\">" + esc(j.job) + "</h2>" + badge(j.status) + overdue + meta + "</header>" +
        "<div class=\"job-body\"><div class=\"facts\">" + kpis + stats + "</div><div class=\"detail\">" + live + err + problems_html(j) + runs + "</div></div></section>"
}

let CSS = r"""
    :root {
      color-scheme: dark;
      --bg: #050a06; --surface: #08110a; --surface-sunk: #040805; --line: #2f6b3e;
      --text: #d2f7da; --text-bright: #7dfca4; --text-muted: #8fc79c; --link: #6fdcff; --focus: #ffb53d;
      --ok-fg: #7dfca4; --ok-bg: #0d2a15; --warn-fg: #ffc061; --warn-bg: #2a1d05;
      --bad-fg: #ff8577; --bad-bg: #2d0d0b; --info-fg: #6fdcff; --info-bg: #06222b; --muted-fg: #9cbfa5; --muted-bg: #0f1a12;
      --mono: "IBM Plex Mono", "JetBrains Mono", "Cascadia Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, "DejaVu Sans Mono", monospace;
      /* Glow only on large text: on body text it blurs the letters. */
      --glow: 0 0 6px color-mix(in srgb, currentColor 35%, transparent);
      --gutter: clamp(1rem, 3vw, 2.5rem);
      -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; font: 0.9375rem/1.5 var(--mono); color: var(--text);
      background: radial-gradient(ellipse at 50% 30%, #0b1a0f 0%, var(--bg) 70%) fixed, var(--bg);
    }
    /* Scanlines and a vignette over everything, never in the way of a click. */
    body::after {
      content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 10;
      background: repeating-linear-gradient(to bottom, transparent 0 2px, rgb(0 0 0 / 0.08) 2px 3px),
                  radial-gradient(ellipse at center, transparent 65%, rgb(0 0 0 / 0.3) 100%);
    }
    @media (prefers-contrast: more), (forced-colors: active) {
      h1, .job-head h2, .kpi .value { text-shadow: none; }
      body::after { display: none; }
    }
    h1, h2, h3, p, dl, dd, ol, ul { margin: 0; }
    code { font: inherit; font-size: 0.875rem; color: var(--text-bright); background: var(--ok-bg); padding: 0 0.375rem; }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

    .topbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; padding: 0.875rem var(--gutter); border-bottom: 3px double var(--line); }
    .brand { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
    .logo { display: block; flex: none; }
    h1 { font-size: 1.25rem; line-height: 1.2; color: var(--text-bright); letter-spacing: 0.02em; text-shadow: 0 0 8px color-mix(in srgb, currentColor 60%, transparent); }
    h1::after { content: "_"; content: "_" / ""; margin-inline-start: 0.1em; }
    @media (prefers-reduced-motion: no-preference) {
      /* Blinks for five seconds after the page loads, then stays lit. */
      h1::after { animation: blink 1s steps(1) 5; }
    }
    @keyframes blink { 50% { opacity: 0; } }
    .sub { color: var(--text-muted); font-size: 0.875rem; flex: 1 1 20rem; }
    button {
      font: inherit; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.375rem 0.875rem;
      border: 1px solid var(--line); border-radius: 0; background: transparent; color: var(--text-muted); cursor: pointer;
      transition-property: background-color, color; transition-duration: 150ms; transition-timing-function: ease-out;
    }
    button::before { content: "[ "; content: "[ " / ""; }
    button::after { content: " ]"; content: " ]" / ""; }
    @media (hover: hover) { button:hover { background: var(--text-bright); color: var(--bg); text-shadow: none; } }

    main { display: grid; gap: 1.5rem; padding: 1.5rem var(--gutter) 3rem; }

    .badge {
      display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; font-weight: 600; line-height: 1.5; padding: 0 0.5rem;
      text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; border: 1px solid currentColor;
    }
    .ok { --tone-fg: var(--ok-fg); --tone-bg: var(--ok-bg); } .warn { --tone-fg: var(--warn-fg); --tone-bg: var(--warn-bg); }
    .bad { --tone-fg: var(--bad-fg); --tone-bg: var(--bad-bg); } .info { --tone-fg: var(--info-fg); --tone-bg: var(--info-bg); }
    .muted { --tone-fg: var(--muted-fg); --tone-bg: var(--muted-bg); }
    .badge, .tick, .count { color: var(--tone-fg); background: var(--tone-bg); }
    /* A failure is shown in inverse video, the loudest thing a terminal can do. */
    .badge.bad, .tick.bad { color: var(--bg); background: var(--bad-fg); border-color: var(--bad-fg); text-shadow: none; }

    .alert { border: 1px solid var(--bad-fg); background: var(--bad-bg); }
    .alert h2 { color: var(--bg); background: var(--bad-fg); text-shadow: none; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.25rem 1rem; }
    .alert h2::before { content: "!! "; content: "!! " / ""; }
    .alert ul { padding: 0.75rem 1rem 0.75rem 2.25rem; color: var(--bad-fg); }

    .job { background: var(--surface); border: 1px solid var(--line); box-shadow: 0 0 24px rgb(125 252 164 / 0.06), inset 0 0 40px rgb(125 252 164 / 0.03); }
    .job-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; padding: 0.875rem 1.25rem; border-bottom: 1px dashed var(--line); border-inline-start: 4px solid var(--tone-fg); }
    .job-head h2 { font-size: 1.25rem; line-height: 1.3; color: var(--text-bright); text-shadow: var(--glow); }
    .job-head h2::before { content: "> "; content: "> " / ""; color: var(--text-muted); }
    .job-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-inline-start: auto; font-size: 0.8125rem; min-width: 0; }
    .job-meta div { display: flex; gap: 0.5rem; align-items: baseline; min-width: 0; }
    .job-meta dt { color: var(--text-muted); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
    .job-meta dd { overflow-wrap: anywhere; }
    .job-body { display: grid; grid-template-columns: minmax(0, 1fr); }
    .facts, .detail { padding: 1.25rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-content: start; min-width: 0; }
    .facts { background: var(--surface-sunk); }
    @media (min-width: 60rem) {
      .job-body { grid-template-columns: minmax(17rem, 22rem) minmax(0, 1fr); }
      .facts { border-inline-end: 1px dashed var(--line); }
    }

    .kpis { display: grid; gap: 1rem; }
    .kpi dt, .stats dt, h3 { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.05em; text-transform: uppercase; }
    .kpi dd { display: grid; }
    .kpi .value { font-size: 1.125rem; font-weight: 600; line-height: 1.2; color: var(--text-bright); text-shadow: var(--glow); font-variant-numeric: tabular-nums; }
    /* The last good backup is the question the page answers; the other two support it. */
    .kpi.lead .value { font-size: 1.75rem; }
    .kpi .when { color: var(--text-muted); font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
    h3 { margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
    h3::before { content: "//"; content: "//" / ""; color: var(--line); }
    .count { font-size: 0.75rem; padding: 0 0.4rem; letter-spacing: 0; }
    .stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr)); gap: 0.75rem 1rem; }
    .stats dd { font-size: 1.0625rem; font-weight: 600; color: var(--text-bright); font-variant-numeric: tabular-nums; }

    .callout { border: 1px solid var(--bad-fg); border-inline-start-width: 4px; background: var(--bad-bg); padding: 0.75rem 1rem; }
    .callout strong { color: var(--bad-fg); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.875rem; }
    .callout p { margin-top: 0.25rem; overflow-wrap: anywhere; font-size: 0.875rem; }
    .callout .problems { margin-block: 0.375rem 0.5rem; }
    .problems { padding-inline-start: 1.5rem; font-size: 0.8125rem; line-height: 1.6; overflow-wrap: anywhere; }
    .problems li::marker { content: "* "; color: var(--warn-fg); }
    details { margin-top: 0.25rem; }
    summary { cursor: pointer; color: var(--link); width: fit-content; font-size: 0.875rem; }

    /* The progress bar as a row of phosphor blocks. */
    progress {
      display: block; width: 100%; height: 1.25rem; margin: 0.25rem 0 0.5rem; padding: 2px;
      -webkit-appearance: none; appearance: none; border: 1px solid var(--text-bright); background: var(--surface-sunk); color: var(--text-bright);
    }
    progress::-webkit-progress-bar { background: transparent; }
    progress::-webkit-progress-value { background: repeating-linear-gradient(to right, var(--text-bright) 0 0.5rem, transparent 0.5rem 0.6875rem); }
    progress::-moz-progress-bar { background: repeating-linear-gradient(to right, var(--text-bright) 0 0.5rem, transparent 0.5rem 0.6875rem); }
    progress:indeterminate { background: repeating-linear-gradient(to right, var(--ok-bg) 0 0.5rem, transparent 0.5rem 0.6875rem) content-box, var(--surface-sunk); }
    progress:indeterminate::-moz-progress-bar { background: transparent; }
    @media (forced-colors: active) { progress { -webkit-appearance: auto; appearance: auto; } }
    .progress-text { font-variant-numeric: tabular-nums; margin-bottom: 0.75rem; }
    .progress-text strong { color: var(--text-bright); }
    .empty { border: 1px dashed var(--line); padding: 1.25rem; color: var(--text-muted); }
    .empty strong { color: var(--text); }

    .block-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
    .block-head h3 { margin: 0; }
    .history { display: flex; gap: 0.25rem; padding: 0; list-style: none; }
    .tick { display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border: 1px solid currentColor; font-size: 0.6875rem; font-weight: 700; }

    /* When the table is wider than its column, a glow on the cut-off edge says it scrolls. */
    .table-wrap {
      overflow-x: auto; width: fit-content; max-width: 100%; border: 1px solid var(--line);
      background:
        linear-gradient(to right, var(--surface) 40%, transparent) left / 2rem 100% no-repeat local,
        linear-gradient(to left, var(--surface) 40%, transparent) right / 2rem 100% no-repeat local,
        radial-gradient(farthest-side at 0 50%, rgb(125 252 164 / 0.5), transparent) left / 1rem 100% no-repeat scroll,
        radial-gradient(farthest-side at 100% 50%, rgb(125 252 164 / 0.5), transparent) right / 1rem 100% no-repeat scroll,
        var(--surface);
    }
    table { border-collapse: collapse; font-size: 0.8125rem; }
    th, td { text-align: start; padding: 0.375rem 1rem; white-space: nowrap; }
    th { color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; border-bottom: 1px solid var(--line); }
    tbody tr + tr td { border-top: 1px dashed color-mix(in srgb, var(--line) 60%, transparent); }
    .num { text-align: end; font-variant-numeric: tabular-nums; }
"""

# Updates the page in place every data-refresh ms (faster while a run is
# going), keeping the reader's place, open disclosures, focus and table scroll.
# Pausable, idle while the tab is hidden or text is selected, and caught up as
# soon as the tab is shown again. When the daemon can't be reached the tab says
# so, rather than going on showing the last health it reported.
let SCRIPT = r"""
(function () {
  var paused = false, timer = null, btn = document.getElementById('pause'), conn = document.getElementById('conn');
  var main = document.getElementById('main'), favicon = document.getElementById('favicon'), logo = document.getElementById('logo');
  btn.addEventListener('click', function () {
    paused = !paused;
    btn.textContent = paused ? 'Resume updates' : 'Pause updates';
  });
  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(update, Number(main.dataset.refresh) || 30000);
  }
  // Replacing the page would drop a selection the reader is about to copy.
  function selecting() {
    var s = window.getSelection();
    return s && !s.isCollapsed && main.contains(s.anchorNode);
  }
  function update() {
    if (paused || document.hidden || selecting()) { schedule(); return; }
    fetch(location.pathname, { cache: 'no-store' }).then(function (r) {
      if (!r.ok) throw new Error(r.status);
      return r.text();
    }).then(function (text) {
      var next = new DOMParser().parseFromString(text, 'text/html');
      var open = Array.prototype.map.call(main.querySelectorAll('details[open]'), function (d) { return d.id; });
      var scrolled = Array.prototype.map.call(main.querySelectorAll('.table-wrap'), function (t) { return [t.id, t.scrollLeft]; });
      var focused = main.contains(document.activeElement) ? document.activeElement.id : '';
      main.innerHTML = next.getElementById('main').innerHTML;
      main.dataset.refresh = next.getElementById('main').dataset.refresh;
      open.forEach(function (id) { var d = document.getElementById(id); if (d) d.open = true; });
      scrolled.forEach(function (s) { var t = document.getElementById(s[0]); if (t) t.scrollLeft = s[1]; });
      if (focused) { var f = document.getElementById(focused); if (f) f.focus({ preventScroll: true }); }
      document.title = next.title;
      favicon.href = next.getElementById('favicon').href;
      logo.src = next.getElementById('logo').src;
      document.getElementById('updated').textContent = next.getElementById('updated').textContent;
      conn.textContent = '';
      schedule();
    }).catch(function () {
      conn.textContent = " · can't reach the daemon, showing the last data it sent. Check: systemctl status bit-by-bit";
      document.title = "bit-by-bit: can't reach the daemon";
      favicon.href = logo.src = favicon.dataset.unreachable;
      schedule();
    });
  }
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && !paused) update();
  });
  schedule();
})();
"""

# The tab icon: an upload arrow whose shaft breaks up into bits, so the
# backup assembles bit by bit as it rises. The arrow's colour is the overall
# health, phosphor green when every backup is fine and orange to red when one
# needs attention, so a background tab still says whether to look.
let ICON_OK = ["#7dfca4", "#16a34a"]
let ICON_BAD = ["#ffb03a", "#f43f5e"]
# The trailing bits: x, y, opacity. They fade and scatter as they fall away.
let ICON_BITS = [[12.2, 19.8, 0.85], [16.2, 19.8, 0.85], [12.2, 23.4, 0.5], [17.6, 23.8, 0.4], [14.4, 26.8, 0.22]]

fn favicon(healthy) {
    (top, bottom) = if healthy { ICON_OK } else { ICON_BAD }
    arrow = "<path d='M16 3.5 L27 14.5 L20 14.5 L20 19 L12 19 L12 14.5 L5 14.5 Z' stroke-linejoin='round'/>" +
        join(map(ICON_BITS, fn(b) "<rect x='{b[0]}' y='{b[1]}' width='3.4' height='3.4' rx='0.7' fill-opacity='{b[2]}'/>"), "")
    svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><defs>" +
        "<radialGradient id='t' cx='0.5' cy='0.25' r='0.8'><stop offset='0' stop-color='#143a21'/><stop offset='1' stop-color='#040a06'/></radialGradient>" +
        "<linearGradient id='a' x1='0' y1='3.5' x2='0' y2='31' gradientUnits='userSpaceOnUse'><stop offset='0' stop-color='" + top + "'/><stop offset='1' stop-color='" + bottom + "'/></linearGradient>" +
        "<filter id='g' x='-50%' y='-50%' width='200%' height='200%'><feGaussianBlur stdDeviation='1.6'/></filter></defs>" +
        "<rect width='32' height='32' rx='8' fill='url(#t)'/>" +
        "<rect x='0.5' y='0.5' width='31' height='31' rx='7.5' fill='none' stroke='#fff' stroke-opacity='0.12'/>" +
        "<g fill='url(#a)' opacity='0.55' filter='url(#g)'>" + arrow + "</g>" +
        "<g fill='url(#a)'>" + arrow + "</g></svg>"
    "data:image/svg+xml," + replace(svg, "#", "%23")
}

## The dashboard page for a snapshot.
export fn render_html(snap) {
    now = snap.daemon.now
    health_text = if snap.healthy { "ok" } else { "needs attention" }
    icon = favicon(snap.healthy)
    # Problems in a run that worked don't make a job unhealthy, but say so
    # beside the healthy badge so the two never seem to disagree.
    with_problems = len(filter(snap.jobs, fn(j) j.status == "partial"))
    noted = if with_problems == 0 { "" } else {
        " <span class=\"badge warn\"><span aria-hidden=\"true\">!</span> " + string(with_problems) + (if with_problems == 1 { " job" } else { " jobs" }) + " with problems</span>"
    }
    overall = if snap.healthy { "<span class=\"badge ok\"><span aria-hidden=\"true\">✓</span> all backups healthy</span>" + noted } else { "<span class=\"badge bad\"><span aria-hidden=\"true\">!</span> needs attention</span>" }
    alert = if snap.healthy { "" } else {
        "<section class=\"alert\" aria-labelledby=\"attention\"><h2 id=\"attention\">needs attention</h2><ul>" + join(map(snap.reasons, li), "") + "</ul></section>"
    }
    cards = join(map(snap.jobs, fn(j) job_card(j, now)), "")
    busy = any(snap.jobs, fn(j) j.status == "running")
    refresh_ms = (if busy { REFRESH_RUNNING_SECONDS } else { REFRESH_SECONDS }) * 1000
    "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
        "<link rel=\"icon\" id=\"favicon\" type=\"image/svg+xml\" href=\"" + icon + "\" data-unreachable=\"" + favicon(false) + "\">" +
        "<title>bit-by-bit: " + health_text + "</title><style>" + CSS + "</style></head><body>" +
        "<header class=\"topbar\"><div class=\"brand\"><img class=\"logo\" id=\"logo\" src=\"" + icon + "\" width=\"28\" height=\"28\" alt=\"\"><h1>bit-by-bit</h1>" + overall + "</div>" +
        "<p class=\"sub\"><span id=\"updated\">daemon up " + esc(dur_text(snap.daemon.uptime_ms)) + " (since " + esc(at_text(snap.daemon.started_at)) +
        ") &middot; updated " + esc(at_text(now)) + "</span><span id=\"conn\" role=\"status\"></span></p>" +
        "<button type=\"button\" id=\"pause\">Pause updates</button></header>" +
        "<main id=\"main\" data-refresh=\"" + string(refresh_ms) + "\">" + alert + cards + "</main><script>" + SCRIPT + "</script></body></html>"
}

# ---- HTTP ------------------------------------------------------------------------

## Answer one request. cfg_cell holds the live config (updated on reload).
export fn handle(req, cfg_cell, db, started_at) {
    unless req.method == "GET" or req.method == "HEAD" { return http.response(405, "method not allowed", headers: { allow: "GET, HEAD" }) }
    snap = snapshot(cell_get(cfg_cell), db, time.now(), started_at)
    match req.path {
        "/" => http.html(render_html(snap))
        "/api/status" => http.json(snap)
        "/healthz" => {
            h = health(snap)
            if h.ok { http.text("ok\n") } else { http.response(503, join(h.reasons, "\n") + "\n", headers: { "content-type": "text/plain; charset=utf-8" }) }
        }
        _ => http.not_found()
    }
}

## Start the dashboard in the background and return the port it bound.
## Raises { kind: "dashboard", message } if the server cannot start (for
## example, the port is taken).
export fn start(cfg_cell, state_dir, started_at) {
    d = cell_get(cfg_cell).dashboard
    db = open_readonly(state_dir)
    task = bg.spawn(fn() http.serve(d.port, fn(req) handle(req, cfg_cell, db, started_at), host: d.host))
    for i in 0..250 {
        p = http.port()
        if p != null { return p }
        if bg.status(task) == "failed" {
            msg = try { bg.result(task) } catch (e) { string(get(e, "message") ?? e) }
            error({ kind: "dashboard", message: "dashboard could not start on {d.host}:{d.port}: {msg}" })
        }
        sleep(20)
    }
    error({ kind: "dashboard", message: "dashboard did not start on {d.host}:{d.port} within 5s" })
}
