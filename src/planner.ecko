import "./scanner.ecko"
import "./util.ecko"

## The index fingerprint of a symlink: its resolved target.
export fn link_sha(target) = "link:" + target

## Protect roots that scanned to nothing although files were backed up from
## them: that is what an unmounted drive (whose mountpoint directory remains)
## looks like, and treating it as "everything deleted" would empty the backup.
## Returns the scan with those roots added to protected and problems.
export fn guard_empty_roots(scan, index, roots) {
    mut protected = scan.protected
    mut problems = scan.problems
    for root in roots {
        if scanner.under_any(root, protected) { continue }
        found = any(scan.entries, fn(e) scanner.under_any(e.path, [root]))
        if found { continue }
        backed_up = len(filter(keys(index), fn(p) scanner.under_any(p, [root])))
        if backed_up > 0 {
            protected = push(protected, root)
            problems = push(problems, "{root}: is empty but {backed_up} file(s) were backed up from it - not deleting them (is a drive unmounted?)")
        }
    }
    merge(scan, { protected: protected, problems: problems })
}

# An attribute counts as changed only when both sides know it: a row indexed
# before it was recorded has null there.
fn differs(e, prev, name) = get(e, name) != null and get(prev, name) != null and get(e, name) != get(prev, name)
fn learns(e, prev, name) = get(e, name) != null and get(prev, name) == null

## True when the file's mode or owner differs from what was backed up.
export fn attrs_changed(e, prev) = differs(e, prev, "mode") or differs(e, prev, "owner")
fn attrs_unknown(e, prev) = learns(e, prev, "mode") or learns(e, prev, "owner")

## Decide what a run must do. Pure: no I/O.
##   scan:  the result of scanner.scan
##   index: state.index for the job ({path: row})
## Returns {
##   actions:   [{ op: "upload" | "check" | "replace" | "delete" | "attrs", path, entry, prev }]
##   unchanged: Int
##   remember:  [{ path, mode, owner }] - attributes to record for rows indexed
##              before they were (no request needed: nothing to compare them with)
## }
## "check" means size or mtime changed: the executor hashes the file and either
## records a touch (same content) or does a replace. "attrs" means only the
## mode or owner changed: the object's metadata is updated in place.
export fn plan(scan, index) {
    mut actions = []
    mut unchanged = 0
    mut remember = []
    present = util.index_by(scan.entries, fn(e) e.path)
    for e in scan.entries {
        prev = get(index, e.path)
        if prev == null {
            actions = push(actions, { op: "upload", path: e.path, entry: e, prev: null })
        } else if prev.kind != e.kind {
            actions = push(actions, { op: "replace", path: e.path, entry: e, prev: prev })
        } else if e.kind == "symlink" {
            if prev.sha256 == link_sha(e.target) {
                unchanged = unchanged + 1
            } else {
                actions = push(actions, { op: "replace", path: e.path, entry: e, prev: prev })
            }
        } else if prev.size == e.size and prev.mtime == e.mtime {
            if attrs_changed(e, prev) {
                actions = push(actions, { op: "attrs", path: e.path, entry: e, prev: prev })
            } else {
                unchanged = unchanged + 1
                if attrs_unknown(e, prev) { remember = push(remember, { path: e.path, mode: get(e, "mode"), owner: get(e, "owner") }) }
            }
        } else {
            actions = push(actions, { op: "check", path: e.path, entry: e, prev: prev })
        }
    }
    for path in sort(keys(index)) {
        if has(present, path) or scanner.under_any(path, scan.protected) { continue }
        actions = push(actions, { op: "delete", path: path, entry: null, prev: get(index, path) })
    }
    { actions: actions, unchanged: unchanged, remember: remember }
}
