import std.time
import std.fmt
import "./state.ecko"
import "./scheduler.ecko"

fn at_text(ms) = if ms == null { "-" } else { time.format_local(ms, "%Y-%m-%d %H:%M") }

## Human-readable byte count: 1536 -> "1.5 KiB".
export fn size_text(n) {
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    mut v = float(n)
    mut u = 0
    while v >= 1024.0 and u < len(units) - 1 {
        v = v / 1024.0
        u = u + 1
    }
    if u == 0 { "{n} B" } else { fmt.fixed(v, 1) + " " + units[u] }
}

## The last check of a job's backup, as the dashboard and status show it:
## null when there has been none.
export fn check_view(v) = if v == null { null } else {
    {
        status: v.status, at: v.started_at, checked: v.checked, sampled: v.sampled,
        problems: v.problem_list, problem_count: v.problems, error: v.error,
    }
}

## One line about the last check, or null when checking is off and there
## has never been one.
export fn check_text(check, on) {
    if check == null { return if on { "not checked yet" } else { null } }
    at = at_text(check.at)
    match check.status {
        "ok" => "checked {at}: all {check.checked} file(s) there, {check.sampled} downloaded and matching"
        "failed" => "checked {at}: {check.problem_count} problem(s), see `bit-by-bit verify`"
        _ => "checked {at}: couldn't finish: {check.error}"
    }
}

## One map per job: { job, status, started_at, finished_at, next_due, counts, error, problems, check, check_on }.
export fn collect(cfg, db, now) = map(cfg.jobs, fn(job) {
    runs = state.recent_runs(db, job.name, 10)
    last = first(runs)
    last_ms = if last == null { null } else { last.started_at }
    {
        job: job.name,
        status: if last == null { "never run" } else { last.status },
        started_at: last_ms,
        finished_at: if last == null { null } else { last.finished_at },
        next_due: scheduler.next_run(job.schedule, runs, now, scheduler.local_offset_ms),
        uploaded: if last == null { 0 } else { last.uploaded },
        replaced: if last == null { 0 } else { last.replaced },
        deleted: if last == null { 0 } else { last.deleted },
        bytes: if last == null { 0 } else { last.bytes },
        error: if last == null { null } else { last.error },
        problems: if last == null { [] } else { last.problem_list },
        problem_count: if last == null { 0 } else { last.problems },
        check: check_view(state.last_verify(db, job.name)),
        check_on: job.verify != null,
    }
})

## Render collect() output as text lines.
export fn render(rows, now) {
    mut out = []
    for r in rows {
        due = if r.next_due <= now { "now" } else { at_text(r.next_due) }
        out = push(out, "{r.job}: {r.status}  last {at_text(r.started_at)}  next {due}")
        if r.started_at != null {
            size = size_text(r.bytes)
            out = push(out, "  uploaded {r.uploaded}, replaced {r.replaced}, deleted {r.deleted}, {size}")
        }
        if r.error != null { out = push(out, "  error: {r.error}") }
        checked = check_text(get(r, "check"), get(r, "check_on") ?? false)
        if checked != null { out = push(out, "  " + checked) }
        for p in take(r.problems, 5) { out = push(out, "  problem: {p}") }
        total = max([get(r, "problem_count") ?? 0, len(r.problems)])
        if total > 5 {
            more = total - 5
            out = push(out, "  ... and {more} more")
        }
    }
    join(out, "\n")
}
