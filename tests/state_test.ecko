import std.test
import std.fs
import std.sql
import "../src/state.ecko"

fn fresh() = state.open(fs.join(fs.temp_dir(), "state"))

fn outcome(status) = {
    status: status, finished_at: 200, uploaded: 1, replaced: 2, deleted: 3, touched: 4,
    pruned: 5, bytes: 99, error: null, problems: ["/a: vanished"],
}

test.case("open creates the directory and is re-openable", fn() {
    dir = fs.join(fs.temp_dir(), "nested-state")
    db = state.open(dir)
    state.put_file(db, "home", { path: "/a", size: 1, mtime: 2, sha256: "h", kind: "file" })
    state.close(db)
    db2 = state.open(dir)
    test.eq(len(keys(state.index(db2, "home"))), 1)
    state.close(db2)
})

test.case("index put, touch, remove, per job", fn() {
    db = fresh()
    state.put_file(db, "home", { path: "/a", size: 1, mtime: 2, sha256: "h1", kind: "file" })
    state.put_file(db, "home", { path: "/b", size: 3, mtime: 4, sha256: "h2", kind: "symlink" })
    state.put_file(db, "other", { path: "/a", size: 9, mtime: 9, sha256: "h9", kind: "file" })
    state.touch_file(db, "home", "/a", 50)
    test.eq(get(state.index(db, "home"), "/a"), { path: "/a", size: 1, mtime: 50, sha256: "h1", kind: "file", mode: null, owner: null })
    state.remove_file(db, "home", "/b")
    test.eq(keys(state.index(db, "home")), ["/a"])
    test.eq(get(state.index(db, "other"), "/a").sha256, "h9")
    state.put_file(db, "home", { path: "/a", size: 7, mtime: 8, sha256: "new", kind: "file" })
    test.eq(get(state.index(db, "home"), "/a").sha256, "new")
})

test.case("modes and owners are stored, touched and learned", fn() {
    db = fresh()
    state.put_file(db, "home", { path: "/a", size: 1, mtime: 2, sha256: "h", kind: "file", mode: "644", owner: "1000:1000" })
    state.put_file(db, "home", { path: "/b", size: 1, mtime: 2, sha256: "h", kind: "file" })
    state.touch_file(db, "home", "/a", 9, mode: "600", owner: "0:0")
    a = get(state.index(db, "home"), "/a")
    test.eq([a.mtime, a.mode, a.owner], [9, "600", "0:0"])
    state.set_attrs(db, "home", [{ path: "/b", mode: "640", owner: "1000:100" }])
    b = get(state.index(db, "home"), "/b")
    test.eq([b.mode, b.owner], ["640", "1000:100"])
})

test.case("replace_index swaps a job's rows atomically", fn() {
    db = fresh()
    state.put_file(db, "home", { path: "/old", size: 1, mtime: 1, sha256: "o", kind: "file" })
    state.replace_index(db, "home", [{ path: "/new", size: 2, mtime: 2, sha256: "n", kind: "file" }])
    test.eq(keys(state.index(db, "home")), ["/new"])
})

test.case("runs lifecycle", fn() {
    db = fresh()
    test.eq(state.last_run(db, "home"), null)
    state.start_run(db, "home", "r1", 100)
    test.eq(state.last_run(db, "home").status, "running")
    state.finish_run(db, "r1", outcome("partial"))
    r = state.last_run(db, "home")
    test.eq(r.status, "partial")
    test.eq(r.problems, 1)
    test.eq(r.problem_list, ["/a: vanished"])
    test.eq(r.bytes, 99)
    state.start_run(db, "home", "r2", 300)
    test.eq(state.last_run(db, "home").id, "r2")
    test.eq(map(state.recent_runs(db, "home", 10), fn(x) x.id), ["r2", "r1"])
})

test.case("mark_interrupted fails stale running rows", fn() {
    db = fresh()
    state.start_run(db, "home", "r1", 100)
    test.eq(state.mark_interrupted(db, 500), 1)
    r = state.last_run(db, "home")
    test.eq(r.status, "failed")
    test.ok(contains(r.error, "interrupted"), r.error)
})

# A daemon restarting while `bit-by-bit run` is still going in another
# process must not mark that run as failed.
test.case("mark_interrupted leaves runs of jobs still in progress alone", fn() {
    db = fresh()
    state.start_run(db, "home", "r1", 100)
    state.start_run(db, "dev", "r2", 100)
    test.eq(state.mark_interrupted(db, 500, ["dev"]), 1)
    test.eq(state.last_run(db, "home").status, "failed")
    test.eq(state.last_run(db, "dev").status, "running")
})

test.case("multipart bookkeeping", fn() {
    db = fresh()
    state.add_multipart(db, "home", "k", "u1")
    state.add_multipart(db, "home", "k", "u1")
    test.eq(state.list_multipart(db, "home"), [{ key: "k", upload_id: "u1" }])
    state.remove_multipart(db, "home", "k", "u1")
    test.eq(state.list_multipart(db, "home"), [])
})

# Databases made before progress tracking have no planned/done columns.
# Opening one must add them, keeping every existing row.
test.case("open migrates an older runs table", fn() {
    dir = fs.join(fs.temp_dir(), "old-state")
    fs.mkdir(dir)
    old = sql.open(fs.join(dir, "state.db"))
    sql.exec(old, "create table runs (id text primary key, job text not null, started_at integer not null, finished_at integer, status text not null, uploaded integer not null default 0, replaced integer not null default 0, deleted integer not null default 0, touched integer not null default 0, pruned integer not null default 0, problems integer not null default 0, bytes integer not null default 0, error text, problem_list text)")
    sql.exec(old, "insert into runs (id, job, started_at, status) values ('r0', 'home', 1, 'ok')")
    sql.close(old)
    db = state.open(dir)
    test.eq(state.last_run(db, "home").id, "r0")
    state.start_run(db, "home", "r1", 2)
    state.set_planned(db, "r1", 10)
    r = state.last_run(db, "home")
    test.eq([r.id, r.planned, r.done], ["r1", 10, 0])
    state.close(db)
    state.close(state.open(dir))   # a second open must not try to add the columns again
})

test.case("a running run's progress is visible before it finishes", fn() {
    db = fresh()
    state.start_run(db, "home", "r1", 100)
    state.set_planned(db, "r1", 50, 150)
    state.save_progress(db, "r1", 7, { uploaded: 5, replaced: 1, deleted: 0, touched: 1, bytes: 4096, problems: ["/x: vanished"] }, 160)
    r = state.last_run(db, "home")
    test.eq([r.status, r.planned, r.done, r.uploaded, r.replaced, r.touched, r.bytes, r.problems, r.problem_list],
        ["running", 50, 7, 5, 1, 1, 4096, 1, ["/x: vanished"]])
    # When uploads began and when a file last finished: the dashboard's rate and stall check.
    test.eq([r.planned_at, r.progress_at], [150, 160])
})
