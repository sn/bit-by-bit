import std.test
import std.fs
import std.http
import std.json
import std.sql
import std.time
import "../src/config.ecko"
import "../src/state.ecko"
import "../src/dashboard.ecko"

let H = 3600000
let STATE_DIR = fs.join(fs.temp_dir(), "dash-state")
# The test's own connection writes runs; the dashboard reads through its own.
let DB = state.open(STATE_DIR)

fn cfg() = config.validate({
    state_dir: STATE_DIR,
    destinations: { d: { provider: "gcs", bucket: "b", credentials_file: "/x" } },
    jobs: [
        { name: "home", destination: "d", prefix: "p1", paths: ["/tmp"], schedule: { every: "6h" } },
        { name: "dev", destination: "d", prefix: "p2", paths: ["/var"], schedule: { daily_at: "02:30" } },
    ],
    dashboard: { listen: "127.0.0.1:0" },
}).config

fn record(job, id, started, status, problems, err) {
    state.start_run(DB, job, id, started)
    state.finish_run(DB, id, {
        status: status, finished_at: started + 60000, uploaded: 3, replaced: 1, deleted: 0,
        touched: 0, pruned: 2, bytes: 2048, error: err, problems: problems,
    })
}

fn reset() = sql.exec(DB, "delete from runs")

let STARTED = time.now()
port = dashboard.start(cell(cfg()), STATE_DIR, STARTED)
fn url(path) = "http://127.0.0.1:{port}{path}"

test.case("binds to the configured host", fn() {
    test.ok(port > 0, "port {port}")
})

test.case("GET / renders every job and updates in place, with a pause control", fn() {
    reset()
    record("home", "r1", time.now() - H, "ok", [], null)
    r = http.get(url("/"))
    test.eq(r.status, 200)
    test.ok(starts_with(get(r.headers, "content-type") ?? "", "text/html"), string(r.headers))
    # A meta refresh reloads the page and throws away the reader's place (WCAG F41).
    test.ok(not contains(r.body, "http-equiv=\"refresh\""), "no page reload")
    test.ok(contains(r.body, "<button type=\"button\" id=\"pause\">Pause updates</button>"), "pause control")
    test.ok(contains(r.body, "<main id=\"main\""), "main landmark")
    test.ok(contains(r.body, "home") and contains(r.body, "dev"), "both jobs")
    test.ok(contains(r.body, "never run"), "dev has not run")
    test.ok(contains(r.body, "No runs yet"), "a job that never ran says so")
})

# The question a backup dashboard answers first: how old is the newest
# backup that worked? A failed run after it doesn't make it newer.
test.case("each job shows how fresh its last good backup is", fn() {
    reset()
    record("home", "r1", time.now() - 3 * H, "ok", [], null)
    record("home", "r2", time.now() - H, "failed", [], "boom")
    body = http.get(url("/")).body
    test.ok(contains(body, "last good backup"), "label")
    test.ok(contains(body, "<span class=\"value\">3h ago</span>"), "fresh from the ok run, not the failed one")
    s = json.decode(http.get(url("/api/status")).body)
    test.eq(s.jobs[0].last_good_at, s.jobs[0].runs[1].finished_at)
    test.eq(s.jobs[1].last_good_at, null)
})

test.case("each job shows its schedule, destination and paths", fn() {
    reset()
    body = http.get(url("/")).body
    test.ok(contains(body, "every 6h") and contains(body, "daily at 02:30"), "schedules")
    test.ok(contains(body, "d/p1") and contains(body, "/tmp"), "destination, prefix and path")
})

test.case("the page uses the full width", fn() {
    reset()
    test.ok(not contains(http.get(url("/")).body, "max-width: 60rem"), "no narrow column")
})

fn running(job, id, started, planned, done, uploaded) = running_at(job, id, started, planned, done, uploaded, time.now(), time.now())

# A run that finished planning at planned_at and last finished a file at progress_at.
fn running_at(job, id, started, planned, done, uploaded, planned_at, progress_at) {
    state.start_run(DB, job, id, started)
    if planned != null { state.set_planned(DB, id, planned, planned_at) }
    if progress_at != null { state.save_progress(DB, id, done, { uploaded: uploaded, replaced: 0, deleted: 0, touched: 0, bytes: 75000000, problems: [] }, progress_at) }
}

test.case("files/s counts from when uploads began, not from the scan", fn() {
    reset()
    now = time.now()
    # An hour of scanning, then 1,000 files in the 10 seconds since.
    running_at("home", "r1", now - H, 5000, 1000, 1000, now - 10000, now)
    test.ok(contains(http.get(url("/")).body, "100 files/s"), "rate since planning")
})

test.case("a run with no file finished for twice its interval is stalled", fn() {
    reset()
    now = time.now()
    running_at("home", "r1", now - 14 * H, 10, 1, 1, now - 14 * H, now - 13 * H)
    r = http.get(url("/healthz"))
    test.eq(r.status, 503)
    test.ok(contains(r.body, "home: stalled"), r.body)
    test.ok(contains(http.get(url("/")).body, "</span> stalled</span>"), "badge")
})

test.case("a long run that keeps finishing files stays healthy", fn() {
    reset()
    now = time.now()
    # A first backup of a big disk: running for 14h, last file a minute ago.
    running_at("home", "r1", now - 14 * H, 900000, 400000, 400000, now - 14 * H + 60000, now - 60000)
    test.eq(http.get(url("/healthz")).status, 200)
})

test.case("a run still scanning after twice its interval is stalled", fn() {
    reset()
    running_at("home", "r1", time.now() - 13 * H, null, 0, 0, null, null)
    test.ok(contains(http.get(url("/healthz")).body, "home: stalled"), "no planning yet")
})

test.case("the top bar notes jobs with problems without calling them unhealthy", fn() {
    reset()
    record("home", "r1", time.now() - H, "partial", ["/a: vanished"], null)
    body = http.get(url("/")).body
    test.ok(contains(body, "all backups healthy"), "still healthy")
    test.ok(contains(body, "<span class=\"badge warn\"><span aria-hidden=\"true\">!</span> 1 job with problems</span>"), "noted")
    record("dev", "r2", time.now() - H, "partial", ["/b: vanished"], null)
    test.ok(contains(http.get(url("/")).body, "2 jobs with problems"), "plural")
    reset()
    record("home", "r3", time.now() - H, "ok", [], null)
    test.ok(not contains(http.get(url("/")).body, "with problems"), "absent when there are none")
})

test.case("a running job shows live progress", fn() {
    reset()
    running("home", "r1", time.now() - 10 * 60000, 300897, 1285, 1280)
    body = http.get(url("/")).body
    test.ok(contains(body, "<progress id=\"progress-home\" max=\"300897\" value=\"1285\" aria-label=\"backup progress of home\">"), "native progress bar")
    test.ok(contains(body, "1,285 of 300,897"), "count in words")
    test.ok(contains(body, "<dt>uploaded</dt><dd>1,280</dd>"), "live counts")
    test.ok(contains(body, "71.5 MiB"), "data so far")
    test.ok(contains(body, "files/s"), "rate")
    test.ok(contains(body, "left"), "time remaining")
    s = json.decode(http.get(url("/api/status")).body)
    test.eq([s.jobs[0].runs[0].planned, s.jobs[0].runs[0].done], [300897, 1285])
})

test.case("a run that is still scanning says so", fn() {
    reset()
    running("home", "r1", time.now() - 5000, null, 0, 0)
    body = http.get(url("/")).body
    test.ok(contains(body, "<progress id=\"progress-home\" aria-label=\"backup progress of home\"></progress>"), "indeterminate bar")
    test.ok(contains(body, "scanning files"), "scanning text")
})

test.case("the page updates faster while a run is going", fn() {
    reset()
    record("home", "r1", time.now() - H, "ok", [], null)
    test.ok(contains(http.get(url("/")).body, "<main id=\"main\" data-refresh=\"30000\">"), "idle: 30s")
    running("home", "r2", time.now() - 5000, 10, 1, 1)
    test.ok(contains(http.get(url("/")).body, "<main id=\"main\" data-refresh=\"3000\">"), "running: 3s")
})

# An attribute of the favicon link.
fn attr(body, name) {
    # Not split on ">": the inline SVG is full of them. Its quotes are single.
    link = split(split(body, "<link rel=\"icon\" ")[1], "<title>")[0]
    parts = split(link, " {name}=\"")
    if len(parts) < 2 { "" } else { split(parts[1], "\"")[0] }
}

test.case("the favicon carries the overall health", fn() {
    reset()
    record("home", "r1", time.now() - H, "ok", [], null)
    ok = http.get(url("/")).body
    test.ok(contains(ok, "<link rel=\"icon\" id=\"favicon\" type=\"image/svg+xml\" href=\"data:image/svg+xml,"), "inline svg icon")
    test.ok(contains(attr(ok, "href"), "%237dfca4") and not contains(attr(ok, "href"), "%23f43f5e"), "green arrow when healthy")
    # The page can't vouch for backups once it loses the daemon: it switches to this.
    test.ok(contains(attr(ok, "data-unreachable"), "%23f43f5e"), "orange-red icon ready for an unreachable daemon")
    record("home", "r2", time.now() - 60000, "failed", [], "boom")
    bad = http.get(url("/")).body
    test.ok(contains(attr(bad, "href"), "%23f43f5e") and not contains(attr(bad, "href"), "%237dfca4"), "orange-red arrow when not")
})

test.case("the header shows the icon beside the name", fn() {
    reset()
    body = http.get(url("/")).body
    # Decorative: the heading beside it already says "bit-by-bit".
    test.ok(contains(body, "<img class=\"logo\" id=\"logo\" src=\"data:image/svg+xml,"), "logo")
    test.ok(contains(body, "width=\"28\" height=\"28\" alt=\"\"><h1>bit-by-bit</h1>"), "sized, decorative, before the name")
})

test.case("the tab title carries the overall health", fn() {
    reset()
    record("home", "r1", time.now() - H, "ok", [], null)
    test.ok(contains(http.get(url("/")).body, "<title>bit-by-bit: ok</title>"), "healthy title")
    record("home", "r2", time.now() - 60000, "failed", [], "boom")
    test.ok(contains(http.get(url("/")).body, "<title>bit-by-bit: needs attention</title>"), "unhealthy title")
})

test.case("a capped problem list shows the full count and says it is capped", fn() {
    reset()
    state.start_run(DB, "home", "r1", time.now() - H)
    state.finish_run(DB, "r1", {
        status: "partial", finished_at: time.now() - H + 60000, uploaded: 0, replaced: 0, deleted: 0,
        touched: 0, pruned: 0, bytes: 0, error: null, problems: ["/a: x", "/b: y"], problem_count: 1500,
    })
    body = http.get(url("/")).body
    test.ok(contains(body, "<span class=\"count warn\">1,500</span>"), "full count")
    test.ok(contains(body, "1,498 more problems not listed"), "says the rest are not listed")
    test.ok(contains(body, "<td class=\"num\">1,500</td></tr>"), "the runs table groups digits too")
})

test.case("every problem is reachable, past the first five behind a disclosure", fn() {
    reset()
    probs = map(0..8, fn(i) "/tmp/file-{i}: vanished")
    record("home", "r1", time.now() - H, "partial", probs, null)
    body = http.get(url("/")).body
    test.ok(all(probs, fn(p) contains(body, p)), "all eight problems")
    test.ok(contains(body, "<summary id=\"problems-home-more\">Show 3 more problems</summary>"), "disclosure")
})

test.case("the runs table scrolls inside its own keyboard-reachable region", fn() {
    reset()
    record("home", "r1", time.now() - H, "ok", [], null)
    body = http.get(url("/")).body
    test.ok(contains(body, "<div class=\"table-wrap\" id=\"runs-home\" role=\"region\" aria-label=\"recent runs of home\" tabindex=\"0\"><table>"), body)
})

test.case("GET /api/status returns the snapshot as JSON", fn() {
    reset()
    record("home", "r1", time.now() - 2 * H, "ok", [], null)
    record("home", "r2", time.now() - H, "partial", ["/tmp/x: vanished"], null)
    r = http.get(url("/api/status"))
    test.eq(r.status, 200)
    s = json.decode(r.body)
    test.eq(s.healthy, true)
    test.eq(s.daemon.started_at, STARTED)
    home = s.jobs[0]
    test.eq([home.job, home.status, home.pruned, home.overdue], ["home", "partial", 2, false])
    test.eq(map(home.runs, fn(x) x.id), ["r2", "r1"])
    test.eq(home.runs[0].duration_ms, 60000)
    test.eq(s.jobs[1].status, "never run")
})

test.case("/healthz is 200 when all is well", fn() {
    reset()
    record("home", "r1", time.now() - H, "ok", [], null)
    r = http.get(url("/healthz"))
    test.eq([r.status, trim(r.body)], [200, "ok"])
})

test.case("/healthz is 503 when a job's last run failed", fn() {
    reset()
    record("home", "r1", time.now() - H, "failed", [], "HTTP 403")
    r = http.get(url("/healthz"))
    test.eq(r.status, 503)
    test.ok(contains(r.body, "home: last run failed"), r.body)
})

test.case("after a failed run the next run is a retry soon, not a full interval", fn() {
    reset()
    # Failed an hour ago: retried 15m after it ended, so it is due now
    # rather than in 5h.
    record("home", "r1", time.now() - H, "failed", [], "HTTP 500")
    snap = json.decode(http.get(url("/api/status")).body)
    home = find(snap.jobs, fn(j) j.job == "home")
    test.ok(home.next_due <= time.now(), "retry is due: {home.next_due}")
})

test.case("/healthz is 503 when a job is overdue", fn() {
    reset()
    record("home", "r1", time.now() - 13 * H, "ok", [], null)
    r = http.get(url("/healthz"))
    test.eq(r.status, 503)
    test.ok(contains(r.body, "home: overdue"), r.body)
})

test.case("everything shown is HTML-escaped", fn() {
    reset()
    record("home", "r1", time.now() - H, "partial", ["/tmp/<script>alert(1)</script>.txt: vanished"], "<b>boom</b>")
    body = http.get(url("/")).body
    test.ok(not contains(body, "<script>alert(1)"), "raw script tag")
    test.ok(contains(body, "&lt;script&gt;alert(1)"), "escaped problem")
    test.ok(contains(body, "&lt;b&gt;boom"), "escaped error")
})

test.case("unknown paths are 404", fn() {
    test.eq(http.get(url("/nope")).status, 404)
})

test.case("the dashboard's connection refuses writes", fn() {
    ro = dashboard.open_readonly(STATE_DIR)
    test.err(fn() sql.exec(ro, "delete from runs"), "readonly")
    sql.close(ro)
})

test.case("health: a never-run job is not unhealthy", fn() {
    reset()
    s = dashboard.snapshot(cfg(), DB, time.now(), STARTED)
    test.eq(dashboard.health(s), { ok: true, reasons: [] })
})

http.stop()
