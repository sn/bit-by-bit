import std.test
import std.fs
import std.os
import "../src/config.ecko"

fn base() = {
    destinations: {
        "aws-main": {
            provider: "s3", endpoint: "https://s3.eu-west-1.amazonaws.com", region: "eu-west-1",
            bucket: "b", credentials_file: "/etc/bit-by-bit/aws.env",
        },
        gcs: { provider: "gcs", bucket: "g", credentials_file: "/x" },
    },
    jobs: [
        { name: "home", destination: "aws-main", prefix: "laptop/home", paths: ["/tmp"], schedule: { every: "6h" } },
    ],
}

fn has_error(r, needle) = any(r.errors, fn(e) contains(e, needle))

test.case("valid config gets defaults", fn() {
    r = config.validate(base())
    test.eq(r.errors, [])
    c = r.config
    test.eq(c.state_dir, "/var/lib/bit-by-bit")
    test.eq(c.concurrency, 4)
    test.eq(c.retry, { attempts: 5, base_delay_ms: 2000, max_delay_ms: 300000 })
    test.eq(c.multipart_threshold, 67108864)
    test.eq(c.jobs[0].schedule, { kind: "every", ms: 21600000 })
    test.eq(c.jobs[0].keep_versions_days, 30)
    test.eq(c.jobs[0].follow_symlinks, false)
    test.eq(c.destinations["aws-main"].server_side_encryption, true)
})

test.case("gcs fills endpoint and region", fn() {
    d = config.validate(base()).config.destinations.gcs
    test.eq(d.endpoint, "https://storage.googleapis.com")
    test.eq(d.region, "auto")
})

test.case("unknown keys are errors with paths", fn() {
    raw = merge(base(), { concurency: 4 })
    r = config.validate(raw)
    test.ok(has_error(r, "$.concurency: unknown key"), string(r.errors))
    j = merge(base().jobs[0], { exlude: [] })
    r2 = config.validate(merge(base(), { jobs: [j] }))
    test.ok(has_error(r2, "$.jobs[0].exlude: unknown key"), string(r2.errors))
})

test.case("all errors are reported together", fn() {
    j = { name: "Bad Name", destination: "nope", prefix: "/x/", paths: ["rel"], schedule: { every: "10s" } }
    r = config.validate(merge(base(), { jobs: [j] }))
    test.ok(has_error(r, "$.jobs[0].name"), "name")
    test.ok(has_error(r, "$.jobs[0].destination: no destination named 'nope'"), "dest")
    test.ok(has_error(r, "$.jobs[0].prefix"), "prefix")
    test.ok(has_error(r, "$.jobs[0].paths[0]: must be an absolute path"), "path")
    test.ok(has_error(r, "$.jobs[0].schedule.every: must be at least 1m"), "every")
})

test.case("schedule needs exactly one kind", fn() {
    j = merge(base().jobs[0], { schedule: { every: "1h", daily_at: "02:00" } })
    r = config.validate(merge(base(), { jobs: [j] }))
    test.ok(has_error(r, "use exactly one of every or daily_at"), string(r.errors))
    j2 = merge(base().jobs[0], { schedule: { daily_at: "02:30" } })
    test.eq(config.validate(merge(base(), { jobs: [j2] })).config.jobs[0].schedule, { kind: "daily_at", hour: 2, minute: 30 })
})

test.case("http endpoint needs allow_insecure", fn() {
    d = { provider: "s3", endpoint: "http://localhost:9000", region: "us-east-1", bucket: "b" }
    r = config.validate(merge(base(), { destinations: { "aws-main": d } }))
    test.ok(has_error(r, "allow_insecure"), string(r.errors))
    d2 = merge(d, { allow_insecure: true })
    test.eq(config.validate(merge(base(), { destinations: { "aws-main": d2 } })).errors, [])
})

test.case("nested prefixes on one destination", fn() {
    j1 = base().jobs[0]
    j2 = merge(j1, { name: "nested", prefix: "laptop/home/sub" })
    r = config.validate(merge(base(), { jobs: [j1, j2] }))
    test.ok(has_error(r, "nested prefixes"), string(r.errors))
})

test.case("duplicate job names and /_versions and /_folders paths", fn() {
    j1 = base().jobs[0]
    j2 = merge(j1, { prefix: "other", paths: ["/_versions/x", "/_folders"] })
    r = config.validate(merge(base(), { jobs: [j1, j2] }))
    test.ok(has_error(r, "duplicate job name 'home'"), "dup")
    test.ok(has_error(r, "paths under /_versions would collide"), "versions")
    test.ok(has_error(r, "paths under /_folders would collide"), "folders")
})

test.case("verify defaults to weekly with 10 files, and false turns it off", fn() {
    r = config.validate(base())
    test.eq(r.config.jobs[0].verify, { every_ms: 7 * 86400000, sample: 10 })
    off = config.validate(merge(base(), { jobs: [merge(base().jobs[0], { verify: false })] }))
    test.eq([off.errors, off.config.jobs[0].verify], [[], null])
    set_ = config.validate(merge(base(), { jobs: [merge(base().jobs[0], { verify: { every: "1d", sample: 0 } })] }))
    test.eq(set_.config.jobs[0].verify, { every_ms: 86400000, sample: 0 })
})

test.case("verify settings are checked", fn() {
    bad = fn(v) config.validate(merge(base(), { jobs: [merge(base().jobs[0], { verify: v })] }))
    test.ok(has_error(bad({ every: "10m" }), "verify.every: must be at least 1h"), "too often")
    test.ok(has_error(bad({ sample: -1 }), "verify.sample: must be an integer from 0 to 10000"), "sample")
    test.ok(has_error(bad({ often: "1d" }), "verify.often: unknown key"), "unknown key")
    test.ok(has_error(bad(true), "verify: must be an object, or false"), "true")
})

test.case("missing path is a warning, not an error", fn() {
    j = merge(base().jobs[0], { paths: ["/definitely/not/here"] })
    r = config.validate(merge(base(), { jobs: [j] }))
    test.eq(r.errors, [])
    test.ok(any(r.warnings, fn(w) contains(w, "does not exist yet")), string(r.warnings))
})

test.case("nested paths within one job are rejected", fn() {
    j = merge(base().jobs[0], { paths: ["/tmp", "/tmp/sub", "/var"] })
    r = config.validate(merge(base(), { jobs: [j] }))
    test.ok(has_error(r, "$.jobs[0].paths[1]: is inside $.jobs[0].paths[0]"), string(r.errors))
})

test.case("credentials file with CRLF line endings", fn() {
    p = fs.join(fs.temp_dir(), "crlf.env")
    fs.write(p, "ACCESS_KEY_ID=AKID\r\nSECRET_ACCESS_KEY=s3cr3t\r\n")
    fs.chmod(p, "600")
    c = config.load_credentials({ name: "crlf", credentials_file: p })
    test.eq(c.access_key, "AKID")
    test.eq(reveal(c.secret_key), "s3cr3t")
})

test.case("dashboard is off unless configured", fn() {
    test.eq(config.validate(base()).config.dashboard, null)
})

test.case("dashboard listen parses host and port", fn() {
    r = config.validate(merge(base(), { dashboard: { listen: "127.0.0.1:8484" } }))
    test.eq(r.errors, [])
    test.eq(r.config.dashboard, { host: "127.0.0.1", port: 8484, allow_remote: false })
    test.eq(config.validate(merge(base(), { dashboard: { listen: "localhost:0" } })).config.dashboard.port, 0)
})

test.case("dashboard refuses non-loopback unless allow_remote", fn() {
    r = config.validate(merge(base(), { dashboard: { listen: "0.0.0.0:8484" } }))
    test.ok(has_error(r, "$.dashboard.listen: 0.0.0.0 is not a loopback address"), string(r.errors))
    r2 = config.validate(merge(base(), { dashboard: { listen: "0.0.0.0:8484", allow_remote: true } }))
    test.eq(r2.errors, [])
})

test.case("dashboard config errors", fn() {
    test.ok(has_error(config.validate(merge(base(), { dashboard: { listen: "8484" } })), "$.dashboard.listen: must be host:port"), "format")
    test.ok(has_error(config.validate(merge(base(), { dashboard: { listen: "127.0.0.1:70000" } })), "$.dashboard.listen: port must be 0-65535"), "range")
    test.ok(has_error(config.validate(merge(base(), { dashboard: { listen: "127.0.0.1:1", lisen: 1 } })), "$.dashboard.lisen: unknown key"), "unknown")
    test.ok(has_error(config.validate(merge(base(), { dashboard: "on" })), "$.dashboard: must be an object"), "type")
})

test.case("not an object", fn() {
    test.eq(config.validate([1]).errors, ["$: config must be a JSON object"])
})

test.case("load raises with every error", fn() {
    dir = fs.temp_dir()
    p = fs.join(dir, "c.json")
    fs.write(p, r"""{"jobs": []}""")
    try {
        config.load(p)
        test.fail("expected a config error")
    } catch (e) {
        test.eq(get(e, "kind"), "config")
        test.ok(len(e.errors) >= 2, string(e.errors))
    }
})

test.case("credentials from file, env wins", fn() {
    dir = fs.temp_dir()
    p = fs.join(dir, "creds.env")
    fs.write(p, "# comment\nACCESS_KEY_ID=AKID\nSECRET_ACCESS_KEY=abc=def\n")
    fs.chmod(p, "600")
    d = { name: "my-dest", credentials_file: p }
    c = config.load_credentials(d)
    test.eq(c.access_key, "AKID")
    test.eq(reveal(c.secret_key), "abc=def")
    test.eq(c.warnings, [])
    test.eq(string(c.secret_key), "[secret]")
    fs.chmod(p, "644")
    test.eq(len(config.load_credentials(d).warnings), 1)
    os.set_env("BBB_MY_DEST_ACCESS_KEY_ID", "ENVID")
    os.set_env("BBB_MY_DEST_SECRET_ACCESS_KEY", "envsecret")
    test.eq(config.load_credentials(d).access_key, "ENVID")
    os.unset_env("BBB_MY_DEST_ACCESS_KEY_ID")
    os.unset_env("BBB_MY_DEST_SECRET_ACCESS_KEY")
})

# Small files are bound by round trips, so high concurrency is the main lever
# for a first upload over a long link.
test.case("concurrency goes up to 128", fn() {
    test.eq(config.validate(merge(base(), { concurrency: 128 })).config.concurrency, 128)
    test.ok(has_error(config.validate(merge(base(), { concurrency: 129 })), "$.concurrency: must be an integer from 1 to 128"), "129 rejected")
})

# S3 refuses a single PUT, and a single part, over 5 GiB.
test.case("multipart sizes stay within S3's 5 GiB limits", fn() {
    r = config.validate(merge(base(), { multipart_threshold: "6GiB", multipart_part_size: "6GiB" }))
    test.ok(has_error(r, "$.multipart_threshold: must be at most 5GiB"), string(r.errors))
    test.ok(has_error(r, "$.multipart_part_size: must be at most 5GiB"), string(r.errors))
    ok = config.validate(merge(base(), { multipart_threshold: "5GiB", multipart_part_size: "5GiB" }))
    test.eq(ok.errors, [])
})
