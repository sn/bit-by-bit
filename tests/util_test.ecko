import std.test
import "../src/util.ecko"

test.case("pool keeps input order", fn() {
    out = util.pool([5, 1, 4, 2, 3], 3, fn(x) {
        sleep(x * 5)
        x * 10
    })
    test.eq(out, [50, 10, 40, 20, 30])
    test.eq(util.pool([], 4, fn(x) x), [])
})

test.case("pool runs up to n at once, and no more", fn() {
    busy = cell(0)
    peak = cell(0)
    util.pool(range(0, 12), 4, fn(x) {
        now = cell_update(busy, fn(b) b + 1)
        cell_update(peak, fn(p) max([p, now]))
        sleep(30)
        cell_update(busy, fn(b) b - 1)
        x
    })
    test.eq(cell_get(peak), 4)
})
