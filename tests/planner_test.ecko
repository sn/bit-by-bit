import std.test
import "../src/planner.ecko"
import "../src/util.ecko"

fn file(path, size, mtime) = { path: path, kind: "file", size: size, mtime: mtime, target: null }
fn link(path, target) = { path: path, kind: "symlink", size: 0, mtime: 0, target: target }
fn idx(size, mtime, sha, kind) = { size: size, mtime: mtime, sha256: sha, kind: kind }

# Build a state-style index from {path: row} literals.
fn index(m) = util.index_by(map(keys(m), fn(k) set(m[k], "path", k)), fn(r) r.path)
fn scan(entries, protected) = { entries: entries, problems: [], protected: protected, skipped: 0 }
fn ops(p) = map(p.actions, fn(a) [a.op, a.path])

test.case("new file uploads", fn() {
    p = planner.plan(scan([file("/a", 1, 1)], []), index({}))
    test.eq(ops(p), [["upload", "/a"]])
})

test.case("unchanged size and mtime is skipped", fn() {
    p = planner.plan(scan([file("/a", 1, 1)], []), index({ "/a": idx(1, 1, "h", "file") }))
    test.eq(ops(p), [])
    test.eq(p.unchanged, 1)
})

test.case("size or mtime change needs a hash check", fn() {
    p = planner.plan(scan([file("/a", 2, 1), file("/b", 1, 9)], []), index({ "/a": idx(1, 1, "h", "file"), "/b": idx(1, 1, "h", "file") }))
    test.eq(ops(p), [["check", "/a"], ["check", "/b"]])
    test.eq(p.actions[0].prev.sha256, "h")
})

test.case("deleted file is deleted", fn() {
    p = planner.plan(scan([], []), index({ "/gone": idx(1, 1, "h", "file") }))
    test.eq(ops(p), [["delete", "/gone"]])
})

test.case("nothing under a protected path is deleted", fn() {
    raw_index = { "/mnt/disk/a": idx(1, 1, "h", "file"), "/mnt/disk/sub/b": idx(1, 1, "h", "file"), "/mnt/diskette": idx(1, 1, "h", "file") }
    p = planner.plan(scan([], ["/mnt/disk"]), index(raw_index))
    test.eq(ops(p), [["delete", "/mnt/diskette"]])
})

test.case("rename is a delete plus an upload", fn() {
    p = planner.plan(scan([file("/new", 1, 1)], []), index({ "/old": idx(1, 1, "h", "file") }))
    test.eq(ops(p), [["upload", "/new"], ["delete", "/old"]])
})

test.case("symlinks compare by target", fn() {
    same = planner.plan(scan([link("/l", "/t")], []), index({ "/l": idx(0, 0, planner.link_sha("/t"), "symlink") }))
    test.eq(ops(same), [])
    moved = planner.plan(scan([link("/l", "/u")], []), index({ "/l": idx(0, 0, planner.link_sha("/t"), "symlink") }))
    test.eq(ops(moved), [["replace", "/l"]])
})

test.case("kind change replaces", fn() {
    p = planner.plan(scan([file("/x", 1, 1)], []), index({ "/x": idx(0, 0, "link:/t", "symlink") }))
    test.eq(ops(p), [["replace", "/x"]])
})

# chmod and chown change neither size nor mtime, so the mode and the owner
# are compared too.
test.case("a mode-only change is an attrs update, and an unknown old mode is remembered", fn() {
    f = fn(path, mode) merge(file(path, 1, 1), { mode: mode, owner: "1000:1000" })
    known = fn(mode) merge(idx(1, 1, "h", "file"), { mode: mode, owner: "1000:1000" })
    p = planner.plan(scan([f("/a", "600"), f("/b", "644"), f("/c", "644")], []),
        index({ "/a": known("644"), "/b": known("644"), "/c": known(null) }))
    test.eq(ops(p), [["attrs", "/a"]])
    test.eq(p.unchanged, 2)
    # Indexes written before modes were recorded learn them without a request.
    test.eq(p.remember, [{ path: "/c", mode: "644", owner: "1000:1000" }])
})

test.case("an owner-only change is an attrs update, and an unknown old owner is remembered", fn() {
    f = fn(path, owner) merge(file(path, 1, 1), { mode: "644", owner: owner })
    known = fn(owner) merge(idx(1, 1, "h", "file"), { mode: "644", owner: owner })
    p = planner.plan(scan([f("/a", "0:0"), f("/b", "1000:1000"), f("/c", "1000:100")], []),
        index({ "/a": known("1000:1000"), "/b": known("1000:1000"), "/c": known(null) }))
    test.eq(ops(p), [["attrs", "/a"]])
    test.eq(p.remember, [{ path: "/c", mode: "644", owner: "1000:100" }])
})
