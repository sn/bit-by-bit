import std.test
import std.time
import std.fs
import "../src/planner.ecko"
import "../src/scanner.ecko"
import "../src/util.ecko"

# Guards against quadratic list/map building: before Ecko 0.66, set() on a map
# and pop()/take() on a list copied the whole collection.
let N = 100000

test.case("planning 100k files is fast", fn() {
    entries = map(range(0, N), fn(i) { path: "/d/{i}", kind: "file", size: i, mtime: 1, target: null })
    rows = map(range(0, N), fn(i) { path: "/d/{i}", size: i, mtime: if i % 10 == 0 { 2 } else { 1 }, sha256: "h", kind: "file" })
    t0 = time.monotonic()
    p = planner.plan({ entries: entries, problems: [], protected: [], skipped: 0 }, util.index_by(rows, fn(r) r.path))
    ms = time.monotonic() - t0
    test.eq(len(p.actions), N / 10)
    test.ok(ms < 10000, "took {ms} ms")
})

test.case("scanning a 20k-file directory is fast", fn() {
    root = fs.join(fs.temp_dir(), "wide")
    fs.mkdir(root)
    for i in 0..20000 { fs.write(fs.join(root, "f{i}"), "x") }
    t0 = time.monotonic()
    r = scanner.scan({ paths: [root], exclude: [], follow_symlinks: false })
    ms = time.monotonic() - t0
    test.eq(len(r.entries), 20000)
    test.ok(ms < 20000, "took {ms} ms")
})

test.case("planning 100k folders is fast", fn() {
    # Sorted by path, as the scanner and the state database give them.
    dirs = sort_by(map(range(0, N), fn(i) { path: "/d/{i}", mode: "755", owner: "1:1", mtime: 1 }), fn(d) d.path)
    t0 = time.monotonic()
    p = planner.plan_dirs(dirs, dirs, ["/d/5"])
    ms = time.monotonic() - t0
    test.eq([len(p.dirs), p.changed], [N, false])
    test.ok(ms < 10000, "took {ms} ms")
})
