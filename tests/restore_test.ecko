import std.test
import std.fs
import std.encoding
import "../src/s3.ecko"
import "../src/state.ecko"
import "../src/sync.ecko"
import "../src/restore.ecko"
import "../testkit/fake_s3.ecko"

port = fake_s3.start()
let CLIENT = s3.client(fake_s3.dest(port), fake_s3.creds(), fake_s3.fast_retry())
let CFG = { concurrency: 2, multipart_threshold: 1000000, multipart_part_size: 5242880 }
let T0 = 1791820438000
let HOUR = 3600000

fn setup() {
    fake_s3.reset()
    root = fs.join(fs.temp_dir(), "src")
    fs.mkdir(root)
    job = { name: "t", prefix: "pc", paths: [root], exclude: [], follow_symlinks: false, keep_versions_days: 30 }
    { root: root, job: job, db: state.open(fs.join(fs.temp_dir(), "state")) }
}

fn run_at(env, ms) = sync.run({
    job: env.job, cfg: CFG, client: CLIENT, db: env.db, run_id: "r" + string(ms),
    run_ts: sync.run_ts_of(ms), now_ms: ms, dry_run: false,
    should_stop: fn() false, log: fn(l, m, f) null,
})

fn opts(extra) = merge({ path: null, at_ms: null, to: fs.join(fs.temp_dir(), "out"), overwrite: false, oldest_ms: 0 }, extra)

# History: T0 a=v1 b=b1 | T0+1h a=v2 | T0+2h b deleted, c created
fn history(env) {
    fs.write(fs.join(env.root, "a.txt"), "v1")
    fs.write(fs.join(env.root, "b.txt"), "b1")
    run_at(env, T0)
    sleep(5)
    fs.write(fs.join(env.root, "a.txt"), "v2")
    run_at(env, T0 + HOUR)
    fs.remove(fs.join(env.root, "b.txt"))
    fs.write(fs.join(env.root, "c.txt"), "c1")
    run_at(env, T0 + 2 * HOUR)
}

fn read_out(o, env, name) = fs.read(o.to + env.root + "/" + name)

test.case("restore latest", fn() {
    env = setup()
    history(env)
    o = opts({})
    r = restore.restore(CLIENT, env.job, o)
    test.eq([r.restored, r.skipped, r.failed], [2, [], []])
    test.eq(read_out(o, env, "a.txt"), "v2")
    test.eq(read_out(o, env, "c.txt"), "c1")
    test.ok(not fs.exists(o.to + env.root + "/b.txt"), "b was deleted")
})

test.case("restore at a point in time", fn() {
    env = setup()
    history(env)
    o = opts({ at_ms: T0 + 30 * 60000 })
    r = restore.restore(CLIENT, env.job, o)
    test.eq(r.restored, 2)
    test.eq(read_out(o, env, "a.txt"), "v1")
    test.eq(read_out(o, env, "b.txt"), "b1")
    test.ok(not fs.exists(o.to + env.root + "/c.txt"), "c did not exist yet")
})

test.case("select lists without downloading", fn() {
    env = setup()
    history(env)
    items = restore.select(CLIENT, env.job, { path: null, at_ms: T0 + 90 * 60000 })
    test.eq(map(items, fn(i) i.path), [env.root + "/a.txt", env.root + "/b.txt"])
})

test.case("--path limits the restore", fn() {
    env = setup()
    history(env)
    items = restore.select(CLIENT, env.job, { path: env.root + "/a.txt", at_ms: null })
    test.eq(len(items), 1)
})

test.case("existing files are skipped unless overwrite", fn() {
    env = setup()
    history(env)
    o = opts({})
    restore.restore(CLIENT, env.job, o)
    r = restore.restore(CLIENT, env.job, o)
    test.eq([r.restored, len(r.skipped)], [0, 2])
    r2 = restore.restore(CLIENT, env.job, merge(o, { overwrite: true }))
    test.eq(r2.restored, 2)
})

test.case("checksum mismatch discards the download", fn() {
    env = setup()
    history(env)
    k = "pc" + env.root + "/a.txt"
    fake_s3.put_raw(k, bytes("tampered"), fake_s3.object(k).meta)
    o = opts({ path: env.root + "/a.txt" })
    r = restore.restore(CLIENT, env.job, o)
    test.eq(r.restored, 0)
    test.ok(contains(r.failed[0], "checksum mismatch"), r.failed[0])
    test.ok(not fs.exists(o.to + env.root + "/a.txt"), "nothing left behind")
    test.ok(not fs.exists(o.to + env.root + "/a.txt.bbb-partial"), "no partial")
})

test.case("mode and mtime are restored", fn() {
    env = setup()
    p = fs.join(env.root, "a.txt")
    fs.write(p, "v1")
    fs.chmod(p, "640")
    run_at(env, T0)
    o = opts({})
    restore.restore(CLIENT, env.job, o)
    out = o.to + p
    test.eq(fs.mode(out), "640")
    test.eq(fs.modified(out), fs.modified(p))
})

# Only root can give a file away, so a restore sets owners when it runs as
# root (chown defaults to that) and leaves files to whoever restores them
# otherwise.
test.case("owners are set when chown is on, and left alone when it is off", fn() {
    env = setup()
    p = fs.join(env.root, "a.txt")
    fs.write(p, "v1")
    run_at(env, T0)
    k = "pc" + p
    fake_s3.put_raw(k, bytes("v1"), merge(fake_s3.object(k).meta, { "bbb-owner": "0:0" }))
    me = fs.owner(p)
    off = opts({ to: fs.join(fs.temp_dir(), "out-nochown"), chown: false })
    r = restore.restore(CLIENT, env.job, off)
    test.eq([r.restored, r.failed], [1, []])
    test.eq(fs.owner(off.to + p), me)
    on = opts({ to: fs.join(fs.temp_dir(), "out-chown"), chown: true })
    r2 = restore.restore(CLIENT, env.job, on)
    test.eq(r2.restored, 0)
    test.ok(any(r2.failed, fn(f) contains(f, "can't set owner 0:0")), string(r2.failed))
    test.ok(not fs.exists(on.to + p) and not fs.exists(on.to + p + ".bbb-partial"), "nothing left behind")
})

test.case("chown defaults to whether the restore runs as root", fn() {
    test.eq(restore.as_root(), fs.owner("/proc/self").uid == 0)
})

test.case("a file name that is not valid UTF-8 backs up and restores", fn() {
    env = setup()
    # U+F7FF is how Ecko spells the raw byte 0xFF in a file name.
    name = "bad\u{F7FF}name.txt"
    fs.write(fs.join(env.root, name), "raw")
    test.eq(fs.list_dir(env.root), [name])
    run_at(env, T0)
    o = opts({})
    r = restore.restore(CLIENT, env.job, o)
    test.eq(r.failed, [])
    test.eq(fs.list_dir(o.to + env.root), [name])
    test.eq(read_out(o, env, name), "raw")
})

test.case("--at older than history is refused", fn() {
    env = setup()
    test.err(fn() restore.restore(CLIENT, env.job, opts({ at_ms: 5, oldest_ms: 1000 })), "older than")
})

test.case("I2: symlink with a non-ASCII target restores", fn() {
    env = setup()
    target = fs.join(env.root, "Música")
    fs.mkdir(target)
    fs.write(fs.join(target, "song.txt"), "la")
    fs.symlink(target, fs.join(env.root, "music-link"))
    run_at(env, T0)
    o = opts({ path: env.root + "/music-link" })
    r = restore.restore(CLIENT, env.job, o)
    test.eq([r.restored, r.failed], [1, []])
    test.eq(fs.canonical(o.to + env.root + "/music-link"), target)
})

test.case("a relative symlink restores relative, and a dangling one restores", fn() {
    env = setup()
    fs.symlink("hello.txt", fs.join(env.root, "rel-link"))
    fs.symlink("nowhere/at/all", fs.join(env.root, "dangling"))
    run_at(env, T0)
    o = opts({ to: fs.join(fs.temp_dir(), "out-links") })
    r = restore.restore(CLIENT, env.job, o)
    test.eq(r.failed, [])
    test.eq(fs.readlink(o.to + env.root + "/rel-link"), "hello.txt")
    test.eq(fs.readlink(o.to + env.root + "/dangling"), "nowhere/at/all")
})

test.case("M5: keys that climb out of --to are refused", fn() {
    env = setup()
    # Under the job's root, so it passes the job's own-paths filter, then
    # climbs out of it.
    fake_s3.put_raw("pc" + env.root + "/../../escape.txt", bytes("x"), {})
    o = opts({})
    r = restore.restore(CLIENT, env.job, o)
    test.eq(r.restored, 0)
    test.ok(any(r.failed, fn(f) contains(f, "unsafe path")), string(r.failed))
    test.ok(not fs.exists(fs.join(fs.dirname(o.to), "escape.txt")), "nothing written outside")
})

test.case("a restore never writes through a symlink it restored", fn() {
    env = setup()
    evil = fs.join(fs.temp_dir(), "evil")
    fs.mkdir(evil)
    # A tampered bucket: x is a link out of --to, then a file "inside" it.
    fake_s3.put_raw("pc" + env.root + "/x", bytes(""), { "bbb-symlink": encoding.url_encode(evil) })
    fake_s3.put_raw("pc" + env.root + "/x/pwned.txt", bytes("gotcha"), {})
    o = opts({ to: fs.join(fs.temp_dir(), "out-traverse") })
    r = restore.restore(CLIENT, env.job, o)
    test.ok(not fs.exists(fs.join(evil, "pwned.txt")), "nothing written through the link")
    # Files go first, so the file lands in a real folder x and the link is
    # then refused because x exists.
    test.ok(not fs.is_symlink(o.to + env.root + "/x"), "no link over the folder")
    test.eq(fs.read(o.to + env.root + "/x/pwned.txt"), "gotcha")
    test.eq(len(r.skipped), 1)
})

test.case("restore downloads several files at a time", fn() {
    env = setup()
    for i in 0..6 { fs.write(fs.join(env.root, "f{i}.txt"), "file {i}") }
    run_at(env, T0)
    fake_s3.delay(".txt", 200)
    o = opts({ to: fs.join(fs.temp_dir(), "out-parallel"), concurrency: 4 })
    r = restore.restore(CLIENT, env.job, o)
    test.eq([r.restored, r.failed], [6, []])
    test.eq(read_out(o, env, "f3.txt"), "file 3")
    test.ok(max(fake_s3.overlaps_()) >= 2, "GETs held at once: {fake_s3.overlaps_()}")
})

test.case("a restore never writes through a symlink already in --to", fn() {
    env = setup()
    evil = fs.join(fs.temp_dir(), "evil2")
    fs.mkdir(evil)
    fake_s3.put_raw("pc" + env.root + "/y/pwned.txt", bytes("gotcha"), {})
    o = opts({ to: fs.join(fs.temp_dir(), "out-prelinked") })
    fs.mkdir(o.to + env.root)
    fs.symlink(evil, o.to + env.root + "/y")
    r = restore.restore(CLIENT, env.job, o)
    test.ok(not fs.exists(fs.join(evil, "pwned.txt")), "nothing written through the link")
    test.ok(any(r.failed, fn(f) contains(f, "is a symlink")), string(r.failed))
})

test.case("a failed download leaves no .bbb-partial file behind", fn() {
    env = setup()
    fs.write(fs.join(env.root, "a.txt"), "v1")
    run_at(env, T0)
    o = opts({ to: fs.join(fs.temp_dir(), "out-partial"), overwrite: true })
    # The target is a non-empty folder, so the final rename fails.
    fs.mkdir(o.to + env.root + "/a.txt/inside")
    r = restore.restore(CLIENT, env.job, o)
    test.eq(len(r.failed), 1)
    test.ok(not fs.exists(o.to + env.root + "/a.txt.bbb-partial"), "partial removed")
})

test.case("a file uploaded in parts restores and is verified by its part hashes", fn() {
    env = setup()
    body = bytes("0123456789abcdef" * 1024)
    fs.write(fs.join(env.root, "big.bin"), body)
    sync.run({
        job: env.job, cfg: merge(CFG, { multipart_threshold: 1000, multipart_part_size: 4096 }), client: CLIENT, db: env.db,
        run_id: "rbig", run_ts: sync.run_ts_of(T0), now_ms: T0, dry_run: false, should_stop: fn() false, log: fn(l, m, f) null,
    })
    o = opts({ to: fs.join(fs.temp_dir(), "out-big") })
    r = restore.restore(CLIENT, env.job, o)
    test.eq([r.restored, r.failed], [1, []])
    test.ok(fs.read_bytes(o.to + env.root + "/big.bin") == body, "same bytes")
    # A corrupted copy in the bucket is caught.
    k = "pc" + env.root + "/big.bin"
    fake_s3.put_raw(k, bytes("X") + body[1..], fake_s3.object(k).meta)
    o2 = opts({ to: fs.join(fs.temp_dir(), "out-big2") })
    r2 = restore.restore(CLIENT, env.job, o2)
    test.ok(any(r2.failed, fn(f) contains(f, "checksum mismatch")), string(r2.failed))
})

test.case("binary content restores byte-for-byte", fn() {
    env = setup()
    blob = encoding.hex_decode("00ff10c3289f0d0a1a7f80fe")
    fs.write(fs.join(env.root, "blob.bin"), blob)
    run_at(env, T0)
    o = opts({})
    restore.restore(CLIENT, env.job, o)
    test.eq(fs.read_bytes(o.to + env.root + "/blob.bin"), blob)
})

fake_s3.stop()
